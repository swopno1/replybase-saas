[
  {
    "type": "message",
    "content": {
      "text": "The best way to understand ReplyBase is to see it work. We are chatting here on the website, but if you click below, our system will sync this session to your phone instantly."
    }
  },
  {
    "type": "condition",
    "content": {
      "variableName": "contact_email",
      "conditions": [
        { "operator": "contains", "value": "@", "nextNodeOrder": 3 }
      ],
      "nextNodeOrder": 2
    }
  },
  {
    "type": "input",
    "content": {
      "text": "Before we switch, what's your email so we can keep your session linked?",
      "variableName": "contact_email",
      "inputType": "email"
    }
  },
  {
    "type": "action",
    "content": {
      "action": "tag_user",
      "tags": ["lead", "demo_interest"]
    }
  },
  {
    "type": "message",
    "content": {
      "text": "Ready to see the magic? Click below to switch to WhatsApp. I'll remember everything we've talked about.",
      "buttons": [
        { "type": "postback", "title": "🟢 Switch to WhatsApp", "payload": "SYNC_{{sync_hash}}" },
        { "type": "postback", "title": "🔵 Switch to Telegram", "payload": "SYNC_TG_{{sync_hash}}" },
        { "type": "postback", "title": "💬 Stay here", "payload": "STAY_HERE" }
      ]
    }
  }
]
