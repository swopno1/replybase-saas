  {
    "order": 9,
    "type": "message",
    "content": {
      "text": "You're all set! 🎉 Our head coach will reach out to {{member_phone}} shortly. We can't wait to see you on the gym floor!",
      "delayMs": 500,
      "typingEnabled": true,
      "typingDurationMs": 1000
    }
  },
