[
  {
    "order": 0,
    "type": "input",
    "content": {
      "text": "👋 Welcome to the ReplyBase Telegram Consultant Bot! I'm here to show you how easily you can automate customer queries and capture leads using our tools.\n\nTo get started, what should I call you?",
      "variableName": "contact_name",
      "inputType": "text"
    }
  },
  {
    "order": 1,
    "type": "condition",
    "content": {
      "variableName": "contact_email",
      "conditions": [
        { "operator": "contains", "value": "@", "nextNodeOrder": 5 }
      ],
      "nextNodeOrder": 2
    }
  },
  {
    "order": 2,
    "type": "input",
    "content": {
      "text": "Awesome to connect, {{contact_name}}! To link your Telegram session with your web admin portal and secure your ROI plan, what is your email address?",
      "variableName": "contact_email",
      "inputType": "email",
      "validationMessage": "That doesn't look like a valid email. Could you double-check your email address?"
    }
  },
  {
    "order": 3,
    "type": "message",
    "content": {
      "text": "Perfect! Can you confirm if {{contact_email}} is correct?",
      "buttons": [
        { "type": "postback", "title": "✅ Yes, confirm email", "payload": "CONFIRM_EMAIL_OK" },
        { "type": "postback", "title": "✍️ No, edit email", "payload": "CONFIRM_EMAIL_CHANGE" }
      ],
      "variableName": "email_confirmation"
    }
  },
  {
    "order": 4,
    "type": "condition",
    "content": {
      "variableName": "email_confirmation",
      "conditions": [
        { "operator": "contains", "value": "change", "nextNodeOrder": 2 }
      ],
      "nextNodeOrder": 5
    }
  },
  {
    "order": 5,
    "type": "action",
    "content": {
      "action": "tag_user",
      "tags": ["lead", "channel_telegram", "telegram_synced"]
    }
  },
  {
    "order": 6,
    "type": "message",
    "content": {
      "text": "Excellent! Your Telegram channel session is now securely connected to your ReplyBase CRM. ✈️\n\n💡 Consultant suggestion: Telegram is incredibly fast and popular, but manual support can bottle-neck growth. With ReplyBase, you can automate repetitive support queries, qualify high-value leads, and hand them off to your team instantly. It's the ultimate B2B/B2C lead capture convenience.\n\nWhat would you like to explore first?",
      "buttons": [
        { "type": "postback", "title": "📊 See Pricing & ROI", "payload": "INTENT_PRICING" },
        { "type": "postback", "title": "📱 See Live Demo", "payload": "INTENT_DEMO" },
        { "type": "postback", "title": "📅 Book a Walkthrough", "payload": "INTENT_BOOKING" },
        { "type": "postback", "title": "🚀 Start Free Trial", "payload": "INTENT_CHECKOUT" }
      ],
      "variableName": "user_intent"
    }
  },
  {
    "order": 7,
    "type": "condition",
    "content": {
      "variableName": "last_user_message_normalized",
      "conditions": [
        { "operator": "contains", "value": "intent_pricing", "nextNodeOrder": 8 },
        { "operator": "contains", "value": "price", "nextNodeOrder": 8 },
        { "operator": "contains", "value": "cost", "nextNodeOrder": 8 },
        { "operator": "contains", "value": "roi", "nextNodeOrder": 8 },
        { "operator": "contains", "value": "intent_demo", "nextNodeOrder": 9 },
        { "operator": "contains", "value": "demo", "nextNodeOrder": 9 },
        { "operator": "contains", "value": "work", "nextNodeOrder": 9 },
        { "operator": "contains", "value": "intent_booking", "nextNodeOrder": 10 },
        { "operator": "contains", "value": "book", "nextNodeOrder": 10 },
        { "operator": "contains", "value": "call", "nextNodeOrder": 10 },
        { "operator": "contains", "value": "intent_checkout", "nextNodeOrder": 12 },
        { "operator": "contains", "value": "trial", "nextNodeOrder": 12 },
        { "operator": "contains", "value": "start", "nextNodeOrder": 12 }
      ],
      "nextNodeOrder": 11
    }
  },
  {
    "order": 8,
    "type": "action",
    "content": {
      "action": "call_flow",
      "targetFlowName": "ReplyBase_SubFlow_Pricing"
    }
  },
  {
    "order": 9,
    "type": "action",
    "content": {
      "action": "call_flow",
      "targetFlowName": "ReplyBase_SubFlow_Demo"
    }
  },
  {
    "order": 10,
    "type": "action",
    "content": {
      "action": "call_flow",
      "targetFlowName": "ReplyBase_SubFlow_Booking"
    }
  },
  {
    "order": 11,
    "type": "action",
    "content": {
      "action": "end_flow",
      "description": "Handover to AI Fallback Orchestrator"
    }
  },
  {
    "order": 12,
    "type": "action",
    "content": {
      "action": "call_flow",
      "targetFlowName": "ReplyBase_SubFlow_Checkout"
    }
  }
]
