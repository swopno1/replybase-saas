  },
  {
    "order": 6,
    "type": "condition",
    "content": {
      "variableName": "booking_post_choice",
      "conditions": [
        { "variableName": "booking_post_choice", "operator": "contains", "value": "pricing", "nextNodeOrder": 7 },
        { "variableName": "booking_post_choice", "operator": "contains", "value": "roi", "nextNodeOrder": 7 },
        { "variableName": "booking_post_choice", "operator": "contains", "value": "demo", "nextNodeOrder": 8 },
        { "variableName": "booking_post_choice", "operator": "contains", "value": "trial", "nextNodeOrder": 9 },
        { "variableName": "booking_post_choice", "operator": "contains", "value": "start", "nextNodeOrder": 9 },
        { "variableName": "booking_post_choice", "operator": "contains", "value": "checkout", "nextNodeOrder": 9 }
