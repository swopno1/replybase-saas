[
  {
    "order": 0,
    "type": "message",
    "content": {
      "text": "I’d be happy to connect you with a member of our team who can walk you through how ReplyBase could fit your business and workflow.",
      "typingEnabled": true,
      "delayMs": 1500
    }
  },
  {
    "order": 1,
    "type": "condition",
    "content": {
      "conditions": [
        { "variableName": "contact_email", "operator": "contains", "value": "@", "nextNodeOrder": 3 },
        { "variableName": "lead_email", "operator": "contains", "value": "@", "nextNodeOrder": 3 }
      ],
      "nextNodeOrder": 2
    }
  },
  {
    "order": 2,
    "type": "input",
