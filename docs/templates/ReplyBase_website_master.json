[
  {
    "order": 0,
    "type": "input",
    "content": {
      "text": "\ud83d\udc4b Welcome to ReplyBase!\n\nI help businesses automate customer conversations, capture more leads, and reply instantly across WhatsApp, webchat, and social messaging.\n\nTo tailor my suggestions for your business, what is your name?",
      "variableName": "lead_name",
      "inputType": "text",
      "typingEnabled": true,
      "delayMs": 1500
    }
  },
  {
    "order": 1,
    "type": "condition",
    "content": {
      "variableName": "contact_email",
      "conditions": [
        {
          "variableName": "contact_email",
          "operator": "contains",
          "value": "@",
          "nextNodeOrder": 3
        }
      ],
      "nextNodeOrder": 2
    }
  },
  {
    "order": 2,
    "type": "input",
    "content": {
      "text": "Nice to meet you, {{lead_name}}! \ud83d\ude80 What's the best email address to send your personalised ROI breakdown and free trial setup?",
      "variableName": "lead_email",
      "inputType": "email",
      "validationMessage": "That doesn't look like a valid email. Could you double-check your email address?",
      "typingEnabled": true,
      "delayMs": 1200
    }
  },
  {
    "order": 3,
    "type": "action",
    "content": {
      "action": "tag_user",
      "tags": [
        "lead",
        "channel_website",
        "manually_confirmed"
      ]
    }
  },
  {
    "order": 4,
    "type": "message",
    "content": {
      "text": "Thanks, {{lead_name}}{{contact_name}}! I've pre-configured your digital dashboard.\n\nReplyBase helps continue conversations through WhatsApp and webchat automatically \u2014 helping businesses capture more leads and respond faster \ud83d\ude80\n\nWhat would you like to explore next?",
      "buttons": [
        {
          "type": "postback",
          "title": "\ud83d\udcca See Pricing & ROI",
          "payload": "See Pricing & ROI"
        },
        {
          "type": "postback",
          "title": "\ud83d\udcf1 See Live Demo",
          "payload": "See Live Demo"
        },
        {
          "type": "postback",
          "title": "\ud83d\udcc5 Book a Walkthrough",
          "payload": "Book a Walkthrough"
        },
        {
          "type": "postback",
          "title": "\ud83d\ude80 Start Free Trial",
          "payload": "Start Free Trial"
        }
      ],
      "variableName": "user_intent",
      "typingEnabled": true,
      "delayMs": 1500
    }
  },
