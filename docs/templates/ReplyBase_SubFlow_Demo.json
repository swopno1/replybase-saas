[
  {
    "order": 0,
    "type": "message",
    "content": {
      "text": "The best way to see the convenience of ReplyBase is in action. We are chatting here on our website, but our system can sync this conversation directly to your phone instantly!"
    }
  },
  {
    "order": 1,
    "type": "condition",
    "content": {
      "conditions": [
        { "variableName": "contact_email", "operator": "contains", "value": "@", "nextNodeOrder": 3 },
        { "variableName": "lead_email", "operator": "contains", "value": "@", "nextNodeOrder": 3 }
      ],
      "nextNodeOrder": 2
    }
  },
  {
    "order": 2,
    "type": "input",
    "content": {
      "text": "What’s the best email address to send your personalised ROI breakdown and free trial setup?",
      "variableName": "lead_email",
      "inputType": "email",
      "validationMessage": "That doesn't look like a valid email. Could you double-check your email address?"
    }
  },
  {
    "order": 3,
    "type": "action",
    "content": {
      "action": "tag_user",
      "tags": ["lead", "demo_interest"]
    }
  },
  {
    "order": 4,
    "type": "message",
    "content": {
      "text": "Ready to experience omnichannel magic? Click below to switch this chat to your phone. I will remember everything we've talked about so far!\n\nOr if you prefer, we can review plans or start a trial directly.",
      "buttons": [
        { "type": "postback", "title": "🟢 Switch to WhatsApp", "payload": "SYNC_{{sync_hash}}" },
        { "type": "postback", "title": "🔵 Switch to Telegram", "payload": "SYNC_TG_{{sync_hash}}" },
        { "type": "postback", "title": "🚀 Start 14-Day Trial", "payload": "Start 14-Day Trial" },
        { "type": "postback", "title": "📊 See Pricing & ROI", "payload": "See Pricing & ROI" }
      ],
      "variableName": "demo_next_step"
    }
  },
  {
    "order": 5,
    "type": "condition",
    "content": {
      "variableName": "demo_next_step",
      "conditions": [
        { "variableName": "demo_next_step", "operator": "contains", "value": "trial", "nextNodeOrder": 6 },
        { "variableName": "demo_next_step", "operator": "contains", "value": "checkout", "nextNodeOrder": 6 },
        { "variableName": "demo_next_step", "operator": "contains", "value": "start", "nextNodeOrder": 6 },
        { "variableName": "demo_next_step", "operator": "contains", "value": "pricing", "nextNodeOrder": 7 },
        { "variableName": "demo_next_step", "operator": "contains", "value": "roi", "nextNodeOrder": 7 }
      ],
      "nextNodeOrder": 8
    }
  },
  {
    "order": 6,
    "type": "action",
    "content": {
      "action": "call_flow",
      "targetFlowName": "ReplyBase_SubFlow_Checkout"
    }
  },
  {
    "order": 7,
    "type": "action",
    "content": {
      "action": "call_flow",
      "targetFlowName": "ReplyBase_SubFlow_Pricing"
    }
  },
  {
    "order": 8,
    "type": "action",
    "content": {
      "action": "end_flow",
      "description": "Handover to AI Fallback Orchestrator"
    }
  }
]
