[
  {
    "order": 0,
    "type": "input",
    "content": {
      "text": "\ud83d\udc4b Welcome to ReplyBase!\n\nSince we\u2019re already chatting on WhatsApp, your number is securely connected automatically \ud83d\udfe2\n\nI help businesses automate customer conversations without losing the human touch.\n\nTo get started, what\u2019s your name?",
      "variableName": "lead_name",
      "inputType": "text",
      "typingEnabled": true,
      "delayMs": 1500
    }
  },
  {
    "order": 1,
    "type": "condition",
    "content": {
      "variableName": "contact_email",
      "conditions": [
        {
          "variableName": "contact_email",
          "operator": "contains",
          "value": "@",
          "nextNodeOrder": 3
        }
      ],
      "nextNodeOrder": 2
    }
  },
  {
    "order": 2,
    "type": "input",
    "content": {
      "text": "Great to meet you, {{lead_name}}!\n\nWhat\u2019s the best email address to set up your ReplyBase dashboard and send over your personalised pricing & ROI breakdown?",
      "variableName": "lead_email",
      "inputType": "email",
      "validationMessage": "That doesn't look like a valid email. Could you double-check your email address?",
      "typingEnabled": true,
      "delayMs": 1200
    }
  },
  {
    "order": 3,
    "type": "action",
    "content": {
      "action": "tag_user",
      "tags": [
        "lead",
        "channel_whatsapp",
        "whatsapp_synced"
      ]
    }
  },
  {
    "order": 4,
    "type": "message",
    "content": {
      "text": "Awesome, {{contact_name || lead_name}}! Your workspace is synced and ready.\n\n\ud83d\udca1 WhatsApp messages have some of the highest open rates of any communication channel.\n\nReplyBase helps businesses automate FAQs, capture leads instantly, and route important conversations directly to their team \ud83d\ude80\n\nWhat is your main goal today?",
      "buttons": [
        {
          "type": "postback",
          "title": "\ud83d\udcca See Pricing & ROI",
          "payload": "See Pricing & ROI"
        },
        {
          "type": "postback",
          "title": "\ud83d\udcf1 See Live Demo",
          "payload": "See Live Demo"
        },
        {
          "type": "postback",
          "title": "\ud83d\udcc5 Book a Walkthrough",
          "payload": "Book a Walkthrough"
        },
        {
          "type": "postback",
          "title": "\ud83d\ude80 Start Free Trial",
          "payload": "Start Free Trial"
        }
      ],
      "variableName": "user_intent",
      "typingEnabled": true,
      "delayMs": 1500
    }
  },
