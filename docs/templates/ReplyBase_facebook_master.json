[
  {
    "order": 0,
    "type": "input",
    "content": {
      "text": "\ud83d\udc4b Welcome to ReplyBase!\n\nSince you\u2019re messaging us through Facebook, we\u2019ve already connected your Messenger profile automatically.\n\nI\u2019m here to help you explore how ReplyBase can automate customer conversations and capture more leads.\n\nTo tailor my answers, what is your name?",
      "variableName": "lead_name",
      "inputType": "text",
      "typingEnabled": true,
      "delayMs": 1500
    }
  },
  {
    "order": 1,
    "type": "condition",
    "content": {
      "conditions": [
        {
          "variableName": "contact_email",
          "operator": "contains",
          "value": "@",
          "nextNodeOrder": 3
        },
        {
          "variableName": "lead_email",
          "operator": "contains",
          "value": "@",
          "nextNodeOrder": 3
        }
      ],
      "nextNodeOrder": 2
    }
  },
  {
    "order": 2,
    "type": "input",
    "content": {
      "text": "Nice to meet you, {{lead_name}}!\n\nWhat\u2019s the best email address to send your personalised ROI breakdown and free 14-day trial setup?",
      "variableName": "lead_email",
      "inputType": "email",
      "validationMessage": "That doesn't look like a valid email. Could you double-check your email address?",
      "typingEnabled": true,
      "delayMs": 1200
    }
  },
  {
    "order": 3,
    "type": "action",
    "content": {
      "action": "tag_user",
      "tags": [
        "lead",
        "channel_facebook",
        "fb_synced"
      ]
    }
  },
  {
    "order": 4,
    "type": "input",
    "content": {
      "text": "Perfect, you're all set! \ud83d\ude80 Your Facebook profile is securely linked.\n\n\ud83d\udca1 Businesses often lose leads simply by replying too slowly on Facebook Messenger.\n\nReplyBase helps automate replies, capture enquiries instantly, and sync conversations directly into your CRM \ud83d\ude80\n\nWhat would you like to explore first?",
      "buttons": [
        {
          "type": "postback",
          "title": "\ud83d\udcca See Pricing & ROI",
          "payload": "See Pricing & ROI"
        },
        {
          "type": "postback",
          "title": "\ud83d\udcf1 See Live Demo",
          "payload": "See Live Demo"
        },
        {
          "type": "postback",
          "title": "\ud83d\udcc5 Book a Walkthrough",
          "payload": "Book a Walkthrough"
        },
        {
          "type": "postback",
          "title": "\ud83d\ude80 Start Free Trial",
          "payload": "Start Free Trial"
        }
      ],
      "variableName": "user_intent",
      "typingEnabled": true,
      "delayMs": 1500
    }
  },
