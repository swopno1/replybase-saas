[
  {
    "order": 0,
    "type": "input",
    "content": {
      "text": "👋 Hello! Welcome to the ReplyBase Facebook Assistant. I help businesses capture leads and handle messages 24/7 without missing a single contact.\n\nTo tailor my answers, what is your name?",
      "variableName": "contact_name",
      "inputType": "text"
    }
  },
  {
    "order": 1,
    "type": "condition",
    "content": {
      "variableName": "contact_email",
      "conditions": [
        { "operator": "contains", "value": "@", "nextNodeOrder": 5 }
      ],
      "nextNodeOrder": 2
    }
  },
  {
    "order": 2,
    "type": "input",
    "content": {
      "text": "Nice to meet you, {{contact_name}}! To link your Facebook chat history with your client dashboard and receive a custom pricing and ROI breakdown, what is your best email?",
      "variableName": "contact_email",
      "inputType": "email",
      "validationMessage": "That doesn't look like a valid email. Could you double-check your email address?"
    }
  },
  {
    "order": 3,
    "type": "message",
    "content": {
      "text": "Great! Can you confirm if {{contact_email}} is correct?",
      "buttons": [
        { "type": "postback", "title": "✅ Yes, that's correct", "payload": "CONFIRM_EMAIL_OK" },
        { "type": "postback", "title": "✍️ No, edit email", "payload": "CONFIRM_EMAIL_CHANGE" }
      ],
      "variableName": "email_confirmation"
    }
  },
  {
    "order": 4,
    "type": "condition",
    "content": {
      "variableName": "email_confirmation",
      "conditions": [
        { "operator": "contains", "value": "change", "nextNodeOrder": 2 }
      ],
      "nextNodeOrder": 5
    }
  },
  {
    "order": 5,
    "type": "action",
    "content": {
      "action": "tag_user",
      "tags": ["lead", "channel_facebook", "fb_synced"]
    }
  },
  {
    "order": 6,
    "type": "message",
    "content": {
      "text": "Perfect, you're all set! 🚀 Your Facebook profile is securely linked.\n\n💡 Consultant suggestion: Facebook Messenger is a goldmine for customer acquisition, but over 62% of social media users expect a response within 10 minutes. ReplyBase automatically captures leads from comments and messages instantly, keeping your pipeline full and syncs everything with your CRM.\n\nWhat would you like to explore first?",
      "buttons": [
        { "type": "postback", "title": "📊 See Pricing & ROI", "payload": "INTENT_PRICING" },
        { "type": "postback", "title": "📱 See Live Demo", "payload": "INTENT_DEMO" },
        { "type": "postback", "title": "📅 Book a Walkthrough", "payload": "INTENT_BOOKING" },
        { "type": "postback", "title": "🚀 Start Free Trial", "payload": "INTENT_CHECKOUT" }
      ],
      "variableName": "user_intent"
    }
  },
  {
    "order": 7,
    "type": "condition",
    "content": {
      "variableName": "last_user_message_normalized",
      "conditions": [
        { "operator": "contains", "value": "intent_pricing", "nextNodeOrder": 8 },
        { "operator": "contains", "value": "price", "nextNodeOrder": 8 },
        { "operator": "contains", "value": "cost", "nextNodeOrder": 8 },
        { "operator": "contains", "value": "roi", "nextNodeOrder": 8 },
        { "operator": "contains", "value": "intent_demo", "nextNodeOrder": 9 },
        { "operator": "contains", "value": "demo", "nextNodeOrder": 9 },
        { "operator": "contains", "value": "work", "nextNodeOrder": 9 },
        { "operator": "contains", "value": "intent_booking", "nextNodeOrder": 10 },
        { "operator": "contains", "value": "book", "nextNodeOrder": 10 },
        { "operator": "contains", "value": "call", "nextNodeOrder": 10 },
        { "operator": "contains", "value": "intent_checkout", "nextNodeOrder": 12 },
        { "operator": "contains", "value": "trial", "nextNodeOrder": 12 },
        { "operator": "contains", "value": "start", "nextNodeOrder": 12 }
      ],
      "nextNodeOrder": 11
    }
  },
  {
    "order": 8,
    "type": "action",
    "content": {
      "action": "call_flow",
      "targetFlowName": "ReplyBase_SubFlow_Pricing"
    }
  },
  {
    "order": 9,
    "type": "action",
    "content": {
      "action": "call_flow",
      "targetFlowName": "ReplyBase_SubFlow_Demo"
    }
  },
  {
    "order": 10,
    "type": "action",
    "content": {
      "action": "call_flow",
      "targetFlowName": "ReplyBase_SubFlow_Booking"
    }
  },
  {
    "order": 11,
    "type": "action",
    "content": {
      "action": "end_flow",
      "description": "Handover to AI Fallback Orchestrator"
    }
  },
  {
    "order": 12,
    "type": "action",
    "content": {
      "action": "call_flow",
      "targetFlowName": "ReplyBase_SubFlow_Checkout"
    }
  }
]
