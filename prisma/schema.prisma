generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth.js models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  accounts Account[]
  sessions Session[]

  // ReplyBase-specific relations
  facebookPages FacebookPage[]
  bots          Bot[]
  usageLogs     UsageLog[]
  executionLogs ExecutionLog[]
  leads         Lead[]

  @@index([tenantId])
  @@map("users")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  aiEnabled Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  bots          Bot[]
  subscriptions Subscription[]
  usageLogs     UsageLog[]

  @@map("tenants")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

// Facebook integration models
model FacebookPage {
  id          String @id @default(cuid())
  facebookId  String @unique // External Facebook Page ID
  name        String
  accessToken String @db.Text
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  botId           String? // Optional link to a Bot
  bot             Bot?    @relation(fields: [botId], references: [id])
  engineConnected Boolean @default(false) // AI engine connection status

  conversations Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([facebookId])
  @@map("facebook_pages")
}

model Conversation {
  id             String       @id @default(cuid())
  facebookPageId String // References FacebookPage.id
  facebookPage   FacebookPage @relation(fields: [facebookPageId], references: [id], onDelete: Cascade)
  userPsid       String // Facebook User PSID
  sessionId      String       @unique // Botpress session ID
  lastActivityAt DateTime     @default(now())

  messageLogs MessageLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([facebookPageId, userPsid])
  @@index([sessionId])
  @@index([facebookPageId])
  @@map("conversations")
}

model MessageLog {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      String // "inbound" or "outbound"
  messageId      String       @unique // External message ID
  content        String       @db.Text
  status         String       @default("success") // "success", "error", "timeout"
  errorDetails   String?      @db.Text

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([messageId])
  @@map("message_logs")
}

model Subscription {
  id                 String    @id @default(cuid())
  stripeId           String    @unique // Stripe subscription ID
  stripeCustomerId   String?   @unique // Stripe customer ID
  status             String    @default("active") // "active", "canceled", "past_due", "trialing"
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean   @default(false)
  trialEndsAt        DateTime? // Trial end date

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscriptions")
}

model Plan {
  id          String @id @default(cuid())
  name        String @unique // "free", "starter", "pro", "enterprise"
  displayName String
  price       Float  @default(0) // Monthly price in USD
  currency    String @default("USD")

  // Limits
  dailyMessageLimit   Int @default(100)
  monthlyMessageLimit Int @default(3000)
  flowExecutionCap    Int @default(100) // Max flows per day
  maxBots             Int @default(1)
  maxChannelsPerBot   Int @default(1)

  // Features
  features Json @default("{}") // Flexible feature flags

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plans")
}

// Bot and channel models
model Bot {
  id          String  @id @default(cuid())
  name        String
  description String?

  // Added fields for bot configuration
  entryFlow      String?
  welcomeMessage String?
  triggers       Json    @default("[]")
  enabled        Boolean @default(true)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  channels      Channel[]
  executionLogs ExecutionLog[]
  facebookPages FacebookPage[] // Linked Facebook pages

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?

  @@index([tenantId])
  @@map("bots")
}

model Channel {
  id          String  @id @default(cuid())
  type        String // e.g., "facebook", "telegram"
  name        String
  accessToken String? @db.Text
  pageId      String? // External page/channel ID
  channelId   String? // Alternative external ID
  isActive    Boolean @default(true)
  enabled     Boolean @default(true) // Enable/disable channel
  killSwitch  Boolean @default(false) // Emergency stop
  config      Json    @default("{}") // Flexible config

  botId String
  bot   Bot    @relation(fields: [botId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([botId])
  @@index([pageId])
  @@index([channelId])
  @@map("channels")
}

// Logging and usage models
model ExecutionLog {
  id        String  @id @default(cuid())
  botId     String
  bot       Bot     @relation(fields: [botId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String? // Botpress session ID

  // Execution details
  flowName      String?
  nodeId        String?
  direction     String // "inbound", "outbound"
  status        String  @default("success") // "success", "error", "timeout", "rate_limited"
  errorMessage  String? @db.Text
  executionTime Int? // Milliseconds

  // Request/Response
  input  String? @db.Text
  output String? @db.Text

  createdAt DateTime @default(now())

  @@index([botId, createdAt])
  @@index([userId, createdAt])
  @@index([sessionId])
  @@map("execution_logs")
}

model UsageLog {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  botId     String?
  channelId String?

  // Usage type
  type String // "message", "flow_execution", "webhook"

  // Counts
  count Int @default(1)

  // Time window
  date DateTime @db.Date // For daily limits

  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?

  @@unique([tenantId, type, date, botId, channelId])
  @@index([tenantId, date, type])
  @@index([botId, date])
  @@map("usage_logs")
}

// CRM models
model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  status    String // e.g., "new", "contacted", "qualified"
  notes     Note[]
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("leads")
}

model Note {
  id        String   @id @default(cuid())
  content   String
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("notes")
}
