generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id                    String            @id @default(cuid())
  name                  String?
  email                 String?           @unique
  isAdmin               Boolean           @default(false)
  role                  UserRole          @default(USER)
  passwordHash          String?
  emailVerified         DateTime?
  image                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  tenantId              String
  accounts              Account[]
  assignedConversations CrmConversation[] @relation("AssignedConversations")
  executionLogs         ExecutionLog[]
  internalNotes         InternalNote[]
  sessions              Session[]
  activityLogs          ActivityLog[]
  usageLogs             UsageLog[]
  flows                 Flow[]
  tenant                Tenant            @relation(fields: [tenantId], references: [id])
  newsletterSubscriptions NewsletterSubscriber[]
  dataDeletionRequests   DataDeletionRequest[]
  passwordResetTokens    PasswordResetToken[]
  adminActivities        AdminActivity[]

  @@index([tenantId])
  @@map("users")
}

model Tenant {
  id            String         @id @default(cuid())
  name          String
  aiEnabled     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  bots          Bot[]
  contacts      Contact[]
  facebookPages FacebookPage[]
  leads         Lead[]
  flows         Flow[]
  subscriptions Subscription?
  usageLogs     UsageLog[]
  users         User[]
  activityLogs  ActivityLog[]
  webChatSites  WebChatSite[]
  aiProvider    String?        @default("default")
  aiModel       String?
  aiApiKey      String?
  newsletterSubscriptions NewsletterSubscriber[]
  dataDeletionRequests    DataDeletionRequest[]
  onboardingMilestoneEvents OnboardingMilestoneEvent[]
  channelStatuses TenantChannelStatus[]
  leadNotificationSettings TenantLeadNotificationSettings?
  revenue       Revenue[]
  isOnboarded   Boolean        @default(false)
  onboardingStep Int           @default(0)
  onboardingData Json          @default("{}")

  @@map("tenants")
}

model TenantLeadNotificationSettings {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  emailRecipients Json     @default("[]")
  telegramChatIds Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_lead_notification_settings")
}

model TenantChannelStatus {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  facebook  Boolean  @default(false)
  telegram  Boolean  @default(true)
  webchat   Boolean  @default(true)
  whatsapp  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_channel_statuses")
}
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model FacebookPage {
  id                  String                @id @default(cuid())
  facebookId          String                @unique
  name                String
  accessToken         String
  tenantId            String
  botId               String?
  engineConnected     Boolean               @default(false)
  webhookSubscribed   Boolean               @default(false)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  crmConversations    CrmConversation[]
  flowAssignments     FlowAssignment[]
  leads               Lead[]
  bot                 Bot?                  @relation(fields: [botId], references: [id])
  tenant              Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  onboardingSessions  OnboardingSession[]

  @@index([tenantId])
  @@index([facebookId])
  @@map("facebook_pages")
}

model Subscription {
  id                 String    @id @default(cuid())
  stripeId           String    @unique
  stripeCustomerId   String?   @unique
  status             String    @default("active")
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean   @default(false)
  trialEndsAt        DateTime?
  planId             String
  tenantId           String    @unique
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  plan               Plan      @relation(fields: [planId], references: [id])
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model NewsletterSubscriber {
  id               String           @id @default(cuid())
  email            String           @unique
  status           NewsletterStatus @default(SUBSCRIBED)
  source           String?
  unsubscribeToken String           @unique
  subscribedAt     DateTime         @default(now())
  unsubscribedAt   DateTime?
  userId           String?
  tenantId         String?
  user             User?            @relation(fields: [userId], references: [id])
  tenant           Tenant?          @relation(fields: [tenantId], references: [id])

  @@index([userId])
  @@index([tenantId])
  @@map("newsletter_subscribers")
}

model DataDeletionRequest {
  id               String             @id @default(cuid())
  email            String
  status           DataDeletionStatus @default(PENDING)
  confirmationCode String             @unique
  source           String?
  requestedAt      DateTime           @default(now())
  scheduledDeletionAt DateTime?
  processedAt      DateTime?
  cancelToken      String?            @unique
  notes            String?
  userId           String?
  tenantId         String?
  user             User?              @relation(fields: [userId], references: [id])
  tenant           Tenant?            @relation(fields: [tenantId], references: [id])

  @@index([email])
  @@index([status])
  @@index([userId])
  @@index([tenantId])
  @@map("data_deletion_requests")
}

model Revenue {
  id                   String   @id @default(cuid())
  stripeInvoiceId      String   @unique
  stripeSubscriptionId String?
  tenantId             String
  amount               Float
  currency             String
  status               String
  paidAt               DateTime @default(now())
  metadata             Json?    @default("{}")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([paidAt])
  @@map("revenue")
}

model Plan {
  id                      String                @id @default(cuid())
  name                    String                @unique
  displayName             String
  price                   Float                 @default(0)
  currency                String                @default("USD")
  dailyMessageLimit       Int                   @default(100)
  monthlyMessageLimit     Int                   @default(3000)
  flowExecutionCap        Int                   @default(100)
  maxBots                 Int                   @default(1)
  maxChannelsPerBot       Int                   @default(1)
  maxConversations        Int                   @default(100)
  maxFlows                Int                   @default(3)
  features                Json                  @default("{}")
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  subscriptions           Subscription[]
  onboardingSessions      OnboardingSession[]

  @@map("plans")
}

model Bot {
  id               String            @id @default(cuid())
  name             String
  description      String?
  entryFlow        String?
  welcomeMessage   String?
  triggers         Json              @default("[]")
  enabled          Boolean           @default(true)
  tenantId         String
  context          Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  channels         Channel[]
  crmConversations CrmConversation[]
  executionLogs    ExecutionLog[]
  facebookPages    FacebookPage[]
  webChatSites     WebChatSite[]

  @@index([tenantId])
  @@map("bots")
}

model Channel {
  id          String   @id @default(cuid())
  type        ChannelType
  name        String
  accessToken String?
  pageId      String?
  channelId   String?
  isActive    Boolean  @default(true)
  enabled     Boolean  @default(true)
  killSwitch  Boolean  @default(false)
  config      Json     @default("{}")
  botId       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bot         Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  flowAssignments FlowChannelAssignment[]

  @@unique([botId, type])
  @@index([botId])
  @@index([pageId])
  @@index([channelId])
  @@index([botId, type])
  @@map("channels")
}

model ExecutionLog {
  id            String   @id @default(cuid())
  botId         String
  userId        String
  sessionId     String?
  flowName      String?
  nodeId        String?
  direction     String
  status        String   @default("success")
  errorMessage  String?
  executionTime Int?
  input         String?
  output        String?
  createdAt     DateTime @default(now())
  bot           Bot      @relation(fields: [botId], references: [id])
  user          User     @relation(fields: [userId], references: [id])

  @@index([botId, createdAt])
  @@index([userId, createdAt])
  @@index([sessionId])
  @@map("execution_logs")
}

model UsageLog {
  id        String   @id @default(cuid())
  tenantId  String
  botId     String?
  channelId String?
  type      String
  count     Int      @default(1)
  date      DateTime @db.Date
  createdAt DateTime @default(now())
  userId    String?
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@unique([tenantId, type, date, botId, channelId])
  @@index([tenantId, date, type])
  @@index([botId, date])
  @@map("usage_logs")
}

model ActivityLog {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String?
  type        String
  title       String
  description String
  entityType  String?
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([entityType, entityId])
  @@map("activity_logs")
}

model SystemHealth {
  id          String   @id @default(cuid())
  system      String   @unique
  isHealthy   Boolean  @default(true)
  lastChecked DateTime @updatedAt
  details     Json?

  @@map("system_health")
}

model Contact {
  id                  String                @id @default(cuid())
  tenantId            String
  name                String?
  email               String?
  phone               String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  identities          ContactIdentity[]
  leads               Lead[]
  tenant              Tenant                @relation(fields: [tenantId], references: [id])
  conversations       CrmConversation[]
  onboardingSessions  OnboardingSession[]

  @@index([tenantId])
  @@map("contacts")
}

model ContactIdentity {
  id        String   @id @default(cuid())
  contactId String
  type      String
  value     String
  createdAt DateTime @default(now())
  contact   Contact  @relation(fields: [contactId], references: [id])

  @@unique([contactId, type, value])
  @@index([contactId])
  @@index([type, value])
  @@map("contact_identities")
}

model CrmConversation {
  id             String             @id @default(cuid())
  contactId      String
  channel        String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  botId          String?
  facebookPageId String?
  status         ConversationStatus @default(OPEN)
  assigneeId     String?
  botPaused      Boolean            @default(false)
  // External session support
  externalSessionId String?
  metadata          Json?
  assignee       User?              @relation("AssignedConversations", fields: [assigneeId], references: [id])
  bot            Bot?               @relation(fields: [botId], references: [id])
  contact        Contact            @relation(fields: [contactId], references: [id])
  facebookPage   FacebookPage?      @relation(fields: [facebookPageId], references: [id])
  messages       CrmMessage[]
  webChatSessions WebChatSession[]
  internalNotes  InternalNote[]

  @@index([contactId])
  @@index([assigneeId])
  @@index([externalSessionId])
  @@index([contactId, botId, channel])
  @@map("crm_conversations")
}

model CrmMessage {
  id             String          @id @default(cuid())
  conversationId String
  direction      String
  content        String
  createdAt      DateTime        @default(now())
  source         String          @default("human")
  conversation   CrmConversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@map("crm_messages")
}

model WebChatSite {
  id             String           @id @default(cuid())
  tenantId       String
  botId          String
  channelId      String?          @unique
  name           String
  publicKey      String           @unique
  secretKey      String
  allowedDomains Json             @default("[]")
  isActive       Boolean          @default(true)
  themeConfig    Json             @default("{}")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  bot            Bot              @relation(fields: [botId], references: [id])
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions       WebChatSession[]
  events         WebChatEvent[]

  @@index([tenantId])
  @@index([botId])
  @@index([isActive])
  @@map("webchat_sites")
}

model WebChatSession {
  id                String          @id @default(cuid())
  siteId            String
  conversationId    String
  externalSessionId String?
  visitorId         String
  fingerprint       String?
  metadata          Json?
  lastSeenAt        DateTime        @default(now())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  conversation      CrmConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  site              WebChatSite     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  events            WebChatEvent[]

  @@unique([siteId, visitorId])
  @@index([conversationId])
  @@index([lastSeenAt])
  @@map("webchat_sessions")
}

model WebChatEvent {
  id         String           @id @default(cuid())
  siteId     String
  sessionId  String?
  type       WebChatEventType
  payload    Json?
  createdAt  DateTime         @default(now())
  session    WebChatSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  site       WebChatSite      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
  @@index([sessionId, createdAt])
  @@index([type, createdAt])
  @@map("webchat_events")
}

model InternalNote {
  id             String          @id @default(cuid())
  content        String
  authorId       String
  conversationId String
  createdAt      DateTime        @default(now())
  author         User            @relation(fields: [authorId], references: [id])
  conversation   CrmConversation @relation(fields: [conversationId], references: [id])

  @@index([authorId])
  @@index([conversationId])
  @@map("internal_notes")
}

model Lead {
  id             String    @id @default(cuid())
  tenantId       String
  contactId      String?
  flowId         String?
  pageId         String?
  tags           Json      @default("[]")
  name           String?
  company        String?
  mobile         String?
  email          String?
  businessType   String?
  source         String    @default("facebook") // facebook, whatsapp, website
  status         String    @default("new") // new, contacted, qualified, converted, lost
  interestedInSubscription Boolean @default(false)
  selectedPlan   String? // free, starter, pro, business
  trialRequested Boolean   @default(false)
  converted      Boolean   @default(false)
  convertedAt    DateTime?
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  contact        Contact?  @relation(fields: [contactId], references: [id])
  flow           Flow?     @relation(fields: [flowId], references: [id])
  page           FacebookPage? @relation(fields: [pageId], references: [id])

  @@index([tenantId])
  @@index([contactId])
  @@index([flowId])
  @@index([pageId])
  @@index([email])
  @@index([status])
  @@map("leads")
}

// Flow Builder Models
model Flow {
  id              String            @id @default(cuid())
  name            String
  description     String?
  tenantId        String
  ownerId         String?           // null = global flow
  isGlobal        Boolean           @default(false)
  isActive        Boolean           @default(false)
  version         Int               @default(1)
  language        String            @default("en")
  fallbackMessage String?           @default("Sorry, I didn't understand that.")
  maxTimeout      Int               @default(300) // seconds
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner           User?             @relation(fields: [ownerId], references: [id])
  nodes           FlowNode[]
  assignments     FlowAssignment[]
  channelAssignments FlowChannelAssignment[]
  sessions        FlowSession[]
  leads           Lead[]

  @@index([tenantId])
  @@index([ownerId])
  @@index([isGlobal])
  @@map("flows")
}

model FlowNode {
  id        String   @id @default(cuid())
  flowId    String
  type      String   // message | input | condition | action | end
  content   Json     // Flexible JSON storage for node config
  order     Int      // Sequential order in flow
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  flow      Flow     @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@index([flowId])
  @@index([order])
  @@map("flow_nodes")
}

model FlowAssignment {
  id        String       @id @default(cuid())
  flowId    String
  pageId    String
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  flow      Flow         @relation(fields: [flowId], references: [id], onDelete: Cascade)
  page      FacebookPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId]) // Only one active flow assignment per page
  @@index([flowId])
  @@index([pageId])
  @@map("flow_assignments")
}

model FlowChannelAssignment {
  id        String   @id @default(cuid())
  flowId    String
  channelId String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  flow      Flow     @relation(fields: [flowId], references: [id], onDelete: Cascade)
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId]) // only one active assignment target per channel
  @@index([flowId])
  @@index([channelId])
  @@index([channelId, isActive])
  @@map("flow_channel_assignments")
}

model FlowSession {
  id             String    @id @default(cuid())
  userId         String    // FB user ID or contact ID
  pageId         String
  flowId         String
  currentNodeId  String?
  variables      Json      @default("{}")
  isActive       Boolean   @default(true)
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  flow           Flow      @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([pageId])
  @@index([flowId])
  @@index([isActive])
  @@map("flow_sessions")
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

// Onboarding Models
model OnboardingSession {
  id                String                    @id @default(cuid())
  tenantId          String?                   // May be null for new tenants
  facebookPageId    String
  conversationId    String
  contactId         String
  stage             OnboardingStage           @default(WELCOME)
  status            OnboardingStatus          @default(IN_PROGRESS)
  
  // Collected Information
  contactName       String?
  businessName      String?
  businessType      String? // e.g., "ecommerce", "service", "saas", "agency"
  phone             String?
  email             String?
  emailFrequency    EmailFrequency            @default(DAILY) // DAILY, WEEKLY, MONTHLY, NEVER
  
  // Selection Data
  selectedPlanId    String?
  demoFlowSelected  String? // Demo template ID based on business type
  
  // Timestamps
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  completedAt       DateTime?
  
  // Relations
  contact           Contact                   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  facebookPage      FacebookPage              @relation(fields: [facebookPageId], references: [id], onDelete: Cascade)
  plan              Plan?                     @relation(fields: [selectedPlanId], references: [id])

  @@index([tenantId])
  @@index([facebookPageId])
  @@index([conversationId])
  @@index([status])
  @@index([stage])
  @@map("onboarding_sessions")
}

model DemoTemplate {
  id                String                    @id @default(cuid())
  name              String                    @unique
  displayName       String
  description       String?
  businessType      String // e.g., "ecommerce", "service", "saas"
  flowJson          Json // Flow structure
  icon              String? // Icon or emoji for UI display
  category          String? // e.g., "engagement", "qualification", "nurture"
  enabled           Boolean                   @default(true)
  order             Int                       @default(0)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([businessType])
  @@index([enabled])
  @@map("demo_templates")
}

model OnboardingMetrics {
  id                String                    @id @default(cuid())
  tenantId          String
  totalSessions     Int                       @default(0)
  completedSessions Int                       @default(0)
  abandonedAt       Json?                     // { stage: count }
  planSelectionDistribution Json? // { planId: count }
  averageTimeToComplete Int? // in minutes
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@unique([tenantId])
  @@map("onboarding_metrics")
}

enum OnboardingStage {
  WELCOME
  COLLECT_INFO
  BUSINESS_TYPE
  CONTACT_INFO
  EMAIL_PREFERENCE
  PACKAGE_SELECTION
  PAYMENT_OR_TRIAL
  DEMO_SELECTION
  CONFIRMATION
  COMPLETED
}

enum OnboardingStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
  FAILED
}

enum EmailFrequency {
  DAILY
  WEEKLY
  MONTHLY
  NEVER
}

enum NewsletterStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

enum UserRole {
  USER
  ADMIN
  SUPERADMIN
}

enum DataDeletionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  ERROR
  REJECTED
  CANCELLED
}

enum WebChatEventType {
  INIT
  MESSAGE
  OPEN
  CLOSE
  TYPING
  ERROR
}

enum ChannelType {
  web
  facebook
  telegram
  whatsapp
}

model OnboardingMilestoneEvent {
  id          String   @id @default(cuid())
  tenantId    String
  milestoneId String   // "first-channel", "first-automated-reply"
  context     Json?    // additional context (channel type, message ID, etc)
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, milestoneId]) // Only one completion per tenant per milestone
  @@index([tenantId])
  @@index([milestoneId])
  @@index([createdAt])
  @@map("onboarding_milestone_events")
}

model WebhookLog {
  id        String   @id @default(cuid())
  type      String   // "verification" | "message" | "postback" | "delivery" | "read"
  source    String   // "facebook" | "stripe" | "whatsapp" | "telegram" etc
  event     String?  // Event name / dedup key when non-null
  data      Json     // Full event payload
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([source])
  @@index([source, event])
  @@map("webhook_logs")
}

model AdminActivity {
  id          String   @id @default(cuid())
  adminId     String
  action      String   // e.g., "USER_PROMOTED", "SUBSCRIPTION_UPDATED", "SYSTEM_CONFIG_CHANGED"
  entityType  String   // "USER", "TENANT", "SUBSCRIPTION", etc.
  entityId    String?
  description String
  metadata    Json?    // Store before/after state or additional context
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  admin       User     @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("admin_activities")
}

model TestHistory {
  id            String   @id @default(cuid())
  type          String   // "unit" | "integration" | "e2e" | "load" | "accessibility" | "security" | "smoke"
  name          String
  status        String   // "passed" | "failed" | "error"
  duration      Int      // in milliseconds
  metrics       Json?    // For load tests: { p50: number, p95: number, throughput: number, errorRate: number }
  output        String?  // Summary of test results or error message
  metadata      Json?    // Environment info, version, etc.
  createdAt     DateTime @default(now())

  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("test_history")
}
