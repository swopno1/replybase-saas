generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// NextAuth.js models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  accounts Account[]
  sessions Session[]

  // ReplyBase-specific relations
  usageLogs     UsageLog[]
  executionLogs ExecutionLog[]

  assignedConversations CrmConversation[] @relation("AssignedConversations")
  internalNotes         InternalNote[]

  @@index([tenantId])
  @@map("users")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  aiEnabled Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  bots          Bot[]
  subscriptions Subscription[]
  usageLogs     UsageLog[]
  contacts      Contact[]
  facebookPages FacebookPage[]

  @@map("tenants")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

// Facebook integration models
model FacebookPage {
  id          String @id @default(cuid())
  facebookId  String @unique // External Facebook Page ID
  name        String
  accessToken String @db.Text

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  botId           String? // Optional link to a Bot
  bot             Bot?    @relation(fields: [botId], references: [id])
  engineConnected Boolean @default(false) // AI engine connection status

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([facebookId])
  @@map("facebook_pages")
}

model Subscription {
  id                 String    @id @default(cuid())
  stripeId           String    @unique // Stripe subscription ID
  stripeCustomerId   String?   @unique // Stripe customer ID
  status             String    @default("active") // "active", "canceled", "past_due", "trialing"
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean   @default(false)
  trialEndsAt        DateTime? // Trial end date

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscriptions")
}

model Plan {
  id          String @id @default(cuid())
  name        String @unique // "free", "starter", "pro", "enterprise"
  displayName String
  price       Float  @default(0) // Monthly price in USD
  currency    String @default("USD")

  // Limits
  dailyMessageLimit   Int @default(100)
  monthlyMessageLimit Int @default(3000)
  flowExecutionCap    Int @default(100) // Max flows per day
  maxBots             Int @default(1)
  maxChannelsPerBot   Int @default(1)
  maxConversations    Int @default(100)

  // Features
  features Json @default("{}") // Flexible feature flags

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plans")
}

// Bot and channel models
model Bot {
  id          String  @id @default(cuid())
  name        String
  description String?

  // Added fields for bot configuration
  entryFlow      String?
  welcomeMessage String?
  triggers       Json    @default("[]")
  enabled        Boolean @default(true)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  channels      Channel[]
  executionLogs ExecutionLog[]
  facebookPages FacebookPage[] // Linked Facebook pages
  crmConversations CrmConversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("bots")
}

model Channel {
  id          String  @id @default(cuid())
  type        String // e.g., "facebook", "telegram"
  name        String
  accessToken String? @db.Text
  pageId      String? // External page/channel ID
  channelId   String? // Alternative external ID
  isActive    Boolean @default(true)
  enabled     Boolean @default(true) // Enable/disable channel
  killSwitch  Boolean @default(false) // Emergency stop
  config      Json    @default("{}") // Flexible config

  botId String
  bot   Bot    @relation(fields: [botId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([botId])
  @@index([pageId])
  @@index([channelId])
  @@map("channels")
}

// Logging and usage models
model ExecutionLog {
  id        String  @id @default(cuid())
  botId     String
  bot       Bot     @relation(fields: [botId], references: [id], onDelete: Restrict)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessionId String? // Botpress session ID

  // Execution details
  flowName      String?
  nodeId        String?
  direction     String // "inbound", "outbound"
  status        String  @default("success") // "success", "error", "timeout", "rate_limited"
  errorMessage  String? @db.Text
  executionTime Int? // Milliseconds

  // Request/Response
  input  String? @db.Text
  output String? @db.Text

  createdAt DateTime @default(now())

  @@index([botId, createdAt])
  @@index([userId, createdAt])
  @@index([sessionId])
  @@map("execution_logs")
}

model UsageLog {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  botId     String?
  channelId String?

  // Usage type
  type String // "message", "flow_execution", "webhook"

  // Counts
  count Int @default(1)

  // Time window
  date DateTime @db.Date // For daily limits

  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?

  @@unique([tenantId, type, date, botId, channelId])
  @@index([tenantId, date, type])
  @@index([botId, date])
  @@map("usage_logs")
}

// System health monitoring
model SystemHealth {
  id          String   @id @default(cuid())
  system      String   @unique // e.g., "ai-engine", "database", "stripe"
  isHealthy   Boolean  @default(true)
  lastChecked DateTime @updatedAt
  details     Json?    // Store additional details, e.g., error messages

  @@map("system_health")
}

// CRM Data Primitives
model Contact {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name      String?
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  identities    ContactIdentity[]
  conversations CrmConversation[]

  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@index([tenantId])
  @@map("contacts")
}

model ContactIdentity {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Restrict)
  type      String // e.g., "email", "phone", "facebook_psid"
  value     String
  createdAt DateTime @default(now())

  @@unique([contactId, type, value])
  @@index([contactId])
  @@map("contact_identities")
}

model CrmConversation {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Restrict)
  channel   String // e.g., "email", "sms", "chat"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  botId String?
  bot   Bot?     @relation(fields: [botId], references: [id])

  messages CrmMessage[]

  status     ConversationStatus @default(OPEN)
  assigneeId String?
  assignee   User?              @relation("AssignedConversations", fields: [assigneeId], references: [id])
  botPaused  Boolean            @default(false)
  internalNotes InternalNote[]

  @@index([contactId])
  @@index([assigneeId])
  @@map("crm_conversations")
}

model CrmMessage {
  id             String          @id @default(cuid())
  conversationId String
  conversation   CrmConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  direction      String // "inbound" or "outbound"
  content        String          @db.Text
  createdAt      DateTime        @default(now())
  source         String          @default("human") // "human" or "ai"

  @@index([conversationId])
  @@map("crm_messages")
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

model InternalNote {
  id              String          @id @default(cuid())
  content         String          @db.Text
  authorId        String
  author          User            @relation(fields: [authorId], references: [id], onDelete: Restrict)
  conversationId  String
  conversation    CrmConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  createdAt       DateTime        @default(now())

  @@index([authorId])
  @@index([conversationId])
  @@map("internal_notes")
}
