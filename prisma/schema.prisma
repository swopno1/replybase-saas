generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id                      String                 @id @default(cuid())
  name                    String?
  email                   String?                @unique
  emailVerified           DateTime?
  image                   String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  tenantId                String
  passwordHash            String?
  isAdmin                 Boolean                @default(false)
  role                    UserRole               @default(USER)
  accounts                Account[]
  activityLogs            ActivityLog[]
  adminActivities         AdminActivity[]
  churnFeedbacks          ChurnFeedback[]
  assignedConversations   CrmConversation[]      @relation("AssignedConversations")
  dataDeletionRequests    DataDeletionRequest[]
  executionLogs           ExecutionLog[]
  flows                   Flow[]
  internalNotes           InternalNote[]
  newsletterSubscriptions NewsletterSubscriber[]
  passwordResetTokens     PasswordResetToken[]
  sessions                Session[]
  usageLogs               UsageLog[]
  tenant                  Tenant                 @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("users")
}

model Tenant {
  id                        String                          @id @default(cuid())
  name                      String
  aiEnabled                 Boolean                         @default(false)
  createdAt                 DateTime                        @default(now())
  updatedAt                 DateTime                        @updatedAt
  aiApiKey                  String?
  aiModel                   String?
  aiProvider                String?                         @default("default")
  isOnboarded               Boolean                         @default(false)
  onboardingData            Json                            @default("{}")
  onboardingStep            Int                             @default(0)
  trialUsed                 Boolean                         @default(false)
  activityLogs              ActivityLog[]
  adminActivities           AdminActivity[]
  bots                      Bot[]
  churnFeedbacks            ChurnFeedback[]
  contacts                  Contact[]
  crmConversations          CrmConversation[]
  crmMessages               CrmMessage[]
  dataDeletionRequests      DataDeletionRequest[]
  facebookPages             FacebookPage[]
  flows                     Flow[]
  internalNotes             InternalNote[]
  leads                     Lead[]
  newsletterSubscriptions   NewsletterSubscriber[]
  onboardingMilestoneEvents OnboardingMilestoneEvent[]
  revenue                   Revenue[]
  subscriptions             Subscription?
  channelStatuses           TenantChannelStatus?
  channels                  Channel[]
  leadNotificationSettings  TenantLeadNotificationSettings?
  usageLogs                 UsageLog[]
  users                     User[]
  webChatSites              WebChatSite[]
  webhookSubscriptions      WebhookSubscription[]
  executionLogs             ExecutionLog[]

  @@map("tenants")
}

model TenantLeadNotificationSettings {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  emailRecipients Json     @default("[]")
  telegramChatIds Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_lead_notification_settings")
}

model TenantChannelStatus {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  facebook  Boolean  @default(false)
  telegram  Boolean  @default(true)
  webchat   Boolean  @default(true)
  whatsapp  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_channel_statuses")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model FacebookPage {
  id                 String              @id @default(cuid())
  facebookId         String              @unique
  name               String
  accessToken        String
  tenantId           String
  botId              String
  engineConnected    Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  webhookSubscribed  Boolean             @default(false)
  crmConversations   CrmConversation[]
  bot                Bot                 @relation(fields: [botId], references: [id])
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  flowAssignments    FlowAssignment?
  leads              Lead[]
  onboardingSessions OnboardingSession[]

  @@index([tenantId])
  @@index([facebookId])
  @@map("facebook_pages")
}

model Subscription {
  id                   String    @id @default(cuid())
  stripeId             String    @unique
  stripeCustomerId     String?   @unique
  status               String    @default("active")
  currentPeriodStart   DateTime  @default(now())
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean   @default(false)
  trialEndsAt          DateTime?
  planId               String
  tenantId             String    @unique
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  downgradeEffectiveAt DateTime?
  downgradeScheduled   Boolean   @default(false)
  plan                 Plan      @relation(fields: [planId], references: [id])
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model StripeEvent {
  id            String    @id @default(cuid())
  stripeEventId String    @unique
  type          String
  status        String    @default("PENDING")
  error         String?
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime? @updatedAt
  processedAt   DateTime?

  @@map("stripe_events")
}

model ChurnFeedback {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  type      String
  reason    String
  planId    String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([type])
  @@map("churn_feedback")
}

model NewsletterSubscriber {
  id               String           @id @default(cuid())
  email            String           @unique
  status           NewsletterStatus @default(SUBSCRIBED)
  source           String?
  unsubscribeToken String           @unique
  subscribedAt     DateTime         @default(now())
  unsubscribedAt   DateTime?
  userId           String?
  tenantId         String?
  tenant           Tenant?          @relation(fields: [tenantId], references: [id])
  user             User?            @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tenantId])
  @@map("newsletter_subscribers")
}

model DataDeletionRequest {
  id                  String             @id @default(cuid())
  email               String
  status              DataDeletionStatus @default(PENDING)
  confirmationCode    String             @unique
  source              String?
  requestedAt         DateTime           @default(now())
  processedAt         DateTime?
  notes               String?
  userId              String?
  tenantId            String?
  cancelToken         String?            @unique
  scheduledDeletionAt DateTime?
  tenant              Tenant?            @relation(fields: [tenantId], references: [id])
  user                User?              @relation(fields: [userId], references: [id])

  @@index([email])
  @@index([status])
  @@index([userId])
  @@index([tenantId])
  @@map("data_deletion_requests")
}

model Revenue {
  id                   String   @id @default(cuid())
  stripeInvoiceId      String   @unique
  stripeSubscriptionId String?
  tenantId             String
  amount               Int
  currency             String
  status               String
  paidAt               DateTime @default(now())
  metadata             Json?    @default("{}")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([paidAt])
  @@map("revenue")
}

model Plan {
  id                  String              @id @default(cuid())
  name                String              @unique
  displayName         String
  price               Int                 @default(0)
  currency            String              @default("USD")
  dailyMessageLimit   Int                 @default(100)
  monthlyMessageLimit Int                 @default(3000)
  flowExecutionCap    Int                 @default(100)
  maxBots             Int                 @default(1)
  maxChannelsPerBot   Int                 @default(1)
  maxConversations    Int                 @default(100)
  features            Json                @default("{}")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  maxFlows            Int                 @default(3)
  onboardingSessions  OnboardingSession[]
  subscriptions       Subscription[]

  @@map("plans")
}

model Bot {
  id               String            @id @default(cuid())
  name             String
  description      String?
  entryFlow        String?
  welcomeMessage   String?
  triggers         Json              @default("[]")
  enabled          Boolean           @default(true)
  tenantId         String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  context          Json?
  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  channels         Channel[]
  crmConversations CrmConversation[]
  executionLogs    ExecutionLog[]
  facebookPages    FacebookPage[]
  webChatSites     WebChatSite[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("bots")
}

model Channel {
  id              String                 @id @default(cuid())
  type            ChannelType
  name            String
  accessToken     String?
  pageId          String?
  channelId       String?
  isActive        Boolean                @default(true)
  enabled         Boolean                @default(true)
  killSwitch      Boolean                @default(false)
  config          Json                   @default("{}")
  tenantId        String
  botId           String
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bot             Bot                    @relation(fields: [botId], references: [id], onDelete: Cascade)
  flowAssignments FlowChannelAssignment?

  @@unique([type, channelId])
  @@index([tenantId])
  @@index([botId])
  @@index([pageId])
  @@index([channelId])
  @@map("channels")
}

model ExecutionLog {
  id            String   @id @default(cuid())
  tenantId      String
  botId         String
  userId        String
  sessionId     String?
  flowName      String?
  nodeId        String?
  direction     String
  status        String   @default("success")
  errorMessage  String?
  executionTime Int?
  input         String?
  output        String?
  createdAt     DateTime @default(now())
  bot           Bot      @relation(fields: [botId], references: [id])
  user          User     @relation(fields: [userId], references: [id])
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([botId, createdAt])
  @@index([userId, createdAt])
  @@index([sessionId])
  @@map("execution_logs")
}

model UsageLog {
  id        String   @id @default(cuid())
  tenantId  String
  botId     String?
  channelId String?
  type      String
  count     Int      @default(1)
  date      DateTime @db.Date
  createdAt DateTime @default(now())
  userId    String?
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@unique([tenantId, type, date, botId, channelId])
  @@index([tenantId, date, type])
  @@index([botId, date])
  @@map("usage_logs")
}

model ActivityLog {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String?
  type        String
  title       String
  description String
  entityType  String?
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([entityType, entityId])
  @@map("activity_logs")
}

model SystemHealth {
  id          String   @id @default(cuid())
  system      String   @unique
  isHealthy   Boolean  @default(true)
  lastChecked DateTime @updatedAt
  details     Json?

  @@map("system_health")
}

model Contact {
  id                 String              @id @default(cuid())
  tenantId           String
  name               String?
  email              String?
  phone              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  identities         ContactIdentity[]
  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  conversations      CrmConversation[]
  leads              Lead[]
  onboardingSessions OnboardingSession[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("contacts")
}

model ContactIdentity {
  id        String   @id @default(cuid())
  contactId String
  type      String
  value     String
  createdAt DateTime @default(now())
  contact   Contact  @relation(fields: [contactId], references: [id])

  @@unique([contactId, type, value])
  @@index([contactId])
  @@index([type, value])
  @@map("contact_identities")
}

model CrmConversation {
  id                String             @id @default(cuid())
  contactId         String
  channel           String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  botId             String?
  facebookPageId    String?
  status            ConversationStatus @default(OPEN)
  assigneeId        String?
  botPaused         Boolean            @default(false)
  externalSessionId String?
  metadata          Json?
  tenantId          String
  assignee          User?              @relation("AssignedConversations", fields: [assigneeId], references: [id])
  bot               Bot?               @relation(fields: [botId], references: [id])
  contact           Contact            @relation(fields: [contactId], references: [id])
  facebookPage      FacebookPage?      @relation(fields: [facebookPageId], references: [id])
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages          CrmMessage[]
  internalNotes     InternalNote[]
  webChatSessions   WebChatSession[]

  @@index([contactId])
  @@index([assigneeId])
  @@index([externalSessionId])
  @@index([contactId, botId, channel])
  @@map("crm_conversations")
}

model CrmMessage {
  id             String          @id @default(cuid())
  conversationId String
  direction      String
  content        String
  createdAt      DateTime        @default(now())
  source         String          @default("human")
  tenantId       String
  conversation   CrmConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([tenantId])
  @@map("crm_messages")
}

model WebChatSite {
  id             String           @id @default(cuid())
  tenantId       String
  botId          String
  channelId      String?          @unique
  name           String
  publicKey      String           @unique
  secretKey      String
  allowedDomains Json             @default("[]")
  isActive       Boolean          @default(true)
  themeConfig    Json             @default("{}")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  events         WebChatEvent[]
  sessions       WebChatSession[]
  bot            Bot              @relation(fields: [botId], references: [id])
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([botId])
  @@index([isActive])
  @@map("webchat_sites")
}

model WebChatSession {
  id                String          @id @default(cuid())
  siteId            String
  conversationId    String
  externalSessionId String?
  visitorId         String
  fingerprint       String?
  metadata          Json?
  lastSeenAt        DateTime        @default(now())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  events            WebChatEvent[]
  conversation      CrmConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  site              WebChatSite     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, visitorId])
  @@index([conversationId])
  @@index([lastSeenAt])
  @@map("webchat_sessions")
}

model WebChatEvent {
  id        String           @id @default(cuid())
  siteId    String
  sessionId String?
  type      WebChatEventType
  payload   Json?
  createdAt DateTime         @default(now())
  session   WebChatSession?  @relation(fields: [sessionId], references: [id])
  site      WebChatSite      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
  @@index([sessionId, createdAt])
  @@index([type, createdAt])
  @@map("webchat_events")
}

model InternalNote {
  id             String          @id @default(cuid())
  content        String
  authorId       String
  conversationId String
  createdAt      DateTime        @default(now())
  tenantId       String
  author         User            @relation(fields: [authorId], references: [id])
  conversation   CrmConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([conversationId])
  @@map("internal_notes")
}

model Lead {
  id                       String        @id @default(cuid())
  tenantId                 String
  contactId                String?
  name                     String?
  company                  String?
  mobile                   String?
  email                    String?
  businessType             String?
  source                   String        @default("facebook")
  status                   String        @default("new")
  interestedInSubscription Boolean       @default(false)
  selectedPlan             String?
  trialRequested           Boolean       @default(false)
  converted                Boolean       @default(false)
  convertedAt              DateTime?
  metadata                 Json?
  insights                 Json?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  flowId                   String?
  pageId                   String?
  tags                     Json          @default("[]")
  contact                  Contact?      @relation(fields: [contactId], references: [id])
  flow                     Flow?         @relation(fields: [flowId], references: [id])
  page                     FacebookPage? @relation(fields: [pageId], references: [id])
  tenant                   Tenant        @relation(fields: [tenantId], references: [id])

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([contactId])
  @@index([flowId])
  @@index([pageId])
  @@index([email])
  @@index([status])
  @@map("leads")
}

model Flow {
  id                 String                  @id @default(cuid())
  name               String
  description        String?
  tenantId           String
  ownerId            String?
  isGlobal           Boolean                 @default(false)
  isActive           Boolean                 @default(false)
  version            Int                     @default(1)
  language           String                  @default("en")
  fallbackMessage    String?                 @default("Sorry, I didn't understand that.")
  maxTimeout         Int                     @default(300)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  assignments        FlowAssignment[]
  channelAssignments FlowChannelAssignment[]
  nodes              FlowNode[]
  sessions           FlowSession[]
  owner              User?                   @relation(fields: [ownerId], references: [id])
  tenant             Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads              Lead[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([ownerId])
  @@index([isGlobal])
  @@map("flows")
}

model FlowNode {
  id        String   @id @default(cuid())
  flowId    String
  type      String
  content   Json
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  flow      Flow     @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@index([flowId])
  @@index([order])
  @@map("flow_nodes")
}

model FlowAssignment {
  id        String       @id @default(cuid())
  flowId    String
  pageId    String       @unique
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  flow      Flow         @relation(fields: [flowId], references: [id], onDelete: Cascade)
  page      FacebookPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([flowId])
  @@index([pageId])
  @@map("flow_assignments")
}

model FlowChannelAssignment {
  id        String   @id @default(cuid())
  flowId    String
  channelId String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  flow      Flow     @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@index([flowId])
  @@index([channelId])
  @@index([channelId, isActive])
  @@map("flow_channel_assignments")
}

model FlowSession {
  id            String    @id @default(cuid())
  userId        String
  pageId        String
  flowId        String
  currentNodeId String?
  variables     Json      @default("{}")
  isActive      Boolean   @default(true)
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  flow          Flow      @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([pageId])
  @@index([flowId])
  @@index([isActive])
  @@map("flow_sessions")
}

model OnboardingSession {
  id               String           @id @default(cuid())
  tenantId         String?
  facebookPageId   String
  conversationId   String
  contactId        String
  stage            OnboardingStage  @default(WELCOME)
  status           OnboardingStatus @default(IN_PROGRESS)
  contactName      String?
  businessName     String?
  businessType     String?
  phone            String?
  email            String?
  emailFrequency   EmailFrequency   @default(DAILY)
  selectedPlanId   String?
  demoFlowSelected String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  completedAt      DateTime?
  contact          Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  facebookPage     FacebookPage     @relation(fields: [facebookPageId], references: [id], onDelete: Cascade)
  plan             Plan?            @relation(fields: [selectedPlanId], references: [id])

  @@index([tenantId])
  @@index([facebookPageId])
  @@index([conversationId])
  @@index([status])
  @@index([stage])
  @@map("onboarding_sessions")
}

model DemoTemplate {
  id           String   @id @default(cuid())
  name         String   @unique
  displayName  String
  description  String?
  businessType String
  flowJson     Json
  icon         String?
  category     String?
  enabled      Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([businessType])
  @@index([enabled])
  @@map("demo_templates")
}

model OnboardingMetrics {
  id                        String   @id @default(cuid())
  tenantId                  String   @unique
  totalSessions             Int      @default(0)
  completedSessions         Int      @default(0)
  abandonedAt               Json?
  planSelectionDistribution Json?
  averageTimeToComplete     Int?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@map("onboarding_metrics")
}

model OnboardingMilestoneEvent {
  id          String   @id @default(cuid())
  tenantId    String
  milestoneId String
  context     Json?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, milestoneId])
  @@index([tenantId])
  @@index([milestoneId])
  @@index([createdAt])
  @@map("onboarding_milestone_events")
}

model WebhookLog {
  id        String   @id @default(cuid())
  type      String
  source    String
  event     String?
  data      Json
  createdAt DateTime @default(now())

  @@unique([source, event], where: raw("((event IS NOT NULL) AND (POSITION((':'::text) IN (event)) > 0))"))
  @@index([createdAt])
  @@index([source])
  @@index([source, event])
  @@map("webhook_logs")
}

model AdminActivity {
  id          String   @id @default(cuid())
  adminId     String
  action      String
  entityType  String
  entityId    String?
  description String
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  tenantId    String?
  admin       User     @relation(fields: [adminId], references: [id])
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([adminId])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("admin_activities")
}

model TestHistory {
  id        String   @id @default(cuid())
  type      String
  name      String
  status    String
  duration  Int
  metrics   Json?
  output    String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("test_history")
}

model IdempotencyKey {
  key       String   @id
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@map("idempotency_keys")
}

model WebhookSubscription {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  url        String
  eventTypes Json // ["lead.created", "lead.updated", "flow.action"]
  secret     String? // For HMAC signing
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("webhook_subscriptions")
}

