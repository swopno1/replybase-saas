generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("APP_DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  
  // Custom Fields for ReplyBase
  facebookPages FacebookPage[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model FacebookPage {
  id          String   @id @default(cuid())
  facebookId  String   @unique // The actual FB Page ID
  name        String
  accessToken String   @db.Text // Encrypted (conceptually, or raw for MVP)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Engine Integration
  botId           String? // ID of the bot in Botpress (workspace)
  engineConnected Boolean @default(false)
  
  // Relations
  conversations Conversation[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Conversation {
  id              String   @id @default(cuid())
  facebookPageId  String   // FK to FacebookPage
  userPsid        String   // Facebook User PSID
  sessionId       String   @unique // Botpress session ID: fb_{pageId}_{psid}
  lastActivityAt  DateTime @default(now())
  
  facebookPage    FacebookPage @relation(fields: [facebookPageId], references: [facebookId], onDelete: Cascade)
  messageLogs     MessageLog[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([facebookPageId, userPsid])
  @@index([sessionId])
}

model MessageLog {
  id             String   @id @default(cuid())
  conversationId String
  direction      String   // "inbound" or "outbound"
  content        String   @db.Text
  status         String   @default("success") // "success", "error", "timeout"
  errorDetails   String?  @db.Text
  
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  
  @@index([conversationId, createdAt])
}
