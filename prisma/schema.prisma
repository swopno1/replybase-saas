generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id                    String            @id @default(cuid())
  name                  String?
  email                 String?           @unique
  emailVerified         DateTime?
  image                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  tenantId              String
  accounts              Account[]
  assignedConversations CrmConversation[] @relation("AssignedConversations")
  executionLogs         ExecutionLog[]
  internalNotes         InternalNote[]
  sessions              Session[]
  usageLogs             UsageLog[]
  tenant                Tenant            @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("users")
}

model Tenant {
  id            String         @id @default(cuid())
  name          String
  aiEnabled     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  bots          Bot[]
  contacts      Contact[]
  facebookPages FacebookPage[]
  leads         Lead[]
  subscriptions Subscription?
  usageLogs     UsageLog[]
  users         User[]

  @@map("tenants")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

model FacebookPage {
  id               String            @id @default(cuid())
  facebookId       String            @unique
  name             String
  accessToken      String
  tenantId         String
  botId            String?
  engineConnected  Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  crmConversations CrmConversation[]
  bot              Bot?              @relation(fields: [botId], references: [id])
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([facebookId])
  @@map("facebook_pages")
}

model Subscription {
  id                 String    @id @default(cuid())
  stripeId           String    @unique
  stripeCustomerId   String?   @unique
  status             String    @default("active")
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean   @default(false)
  trialEndsAt        DateTime?
  planId             String
  tenantId           String    @unique
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  plan               Plan      @relation(fields: [planId], references: [id])
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Plan {
  id                  String         @id @default(cuid())
  name                String         @unique
  displayName         String
  price               Float          @default(0)
  currency            String         @default("USD")
  dailyMessageLimit   Int            @default(100)
  monthlyMessageLimit Int            @default(3000)
  flowExecutionCap    Int            @default(100)
  maxBots             Int            @default(1)
  maxChannelsPerBot   Int            @default(1)
  maxConversations    Int            @default(100)
  features            Json           @default("{}")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  subscriptions       Subscription[]

  @@map("plans")
}

model Bot {
  id               String            @id @default(cuid())
  name             String
  description      String?
  entryFlow        String?
  welcomeMessage   String?
  triggers         Json              @default("[]")
  enabled          Boolean           @default(true)
  tenantId         String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  channels         Channel[]
  crmConversations CrmConversation[]
  executionLogs    ExecutionLog[]
  facebookPages    FacebookPage[]

  @@index([tenantId])
  @@map("bots")
}

model Channel {
  id          String   @id @default(cuid())
  type        String
  name        String
  accessToken String?
  pageId      String?
  channelId   String?
  isActive    Boolean  @default(true)
  enabled     Boolean  @default(true)
  killSwitch  Boolean  @default(false)
  config      Json     @default("{}")
  botId       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bot         Bot      @relation(fields: [botId], references: [id])

  @@index([botId])
  @@index([pageId])
  @@index([channelId])
  @@map("channels")
}

model ExecutionLog {
  id            String   @id @default(cuid())
  botId         String
  userId        String
  sessionId     String?
  flowName      String?
  nodeId        String?
  direction     String
  status        String   @default("success")
  errorMessage  String?
  executionTime Int?
  input         String?
  output        String?
  createdAt     DateTime @default(now())
  bot           Bot      @relation(fields: [botId], references: [id])
  user          User     @relation(fields: [userId], references: [id])

  @@index([botId, createdAt])
  @@index([userId, createdAt])
  @@index([sessionId])
  @@map("execution_logs")
}

model UsageLog {
  id        String   @id @default(cuid())
  tenantId  String
  botId     String?
  channelId String?
  type      String
  count     Int      @default(1)
  date      DateTime @db.Date
  createdAt DateTime @default(now())
  userId    String?
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@unique([tenantId, type, date, botId, channelId])
  @@index([tenantId, date, type])
  @@index([botId, date])
  @@map("usage_logs")
}

model SystemHealth {
  id          String   @id @default(cuid())
  system      String   @unique
  isHealthy   Boolean  @default(true)
  lastChecked DateTime @updatedAt
  details     Json?

  @@map("system_health")
}

model Contact {
  id            String            @id @default(cuid())
  tenantId      String
  name          String?
  email         String?
  phone         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  identities    ContactIdentity[]
  leads         Lead[]
  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  conversations CrmConversation[]

  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@index([tenantId])
  @@map("contacts")
}

model ContactIdentity {
  id        String   @id @default(cuid())
  contactId String
  type      String
  value     String
  createdAt DateTime @default(now())
  contact   Contact  @relation(fields: [contactId], references: [id])

  @@unique([contactId, type, value])
  @@index([contactId])
  @@map("contact_identities")
}

model CrmConversation {
  id             String             @id @default(cuid())
  contactId      String
  channel        String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  botId          String?
  facebookPageId String?
  status         ConversationStatus @default(OPEN)
  assigneeId     String?
  botPaused      Boolean            @default(false)
  // Typebot support
  externalSessionId String?
  metadata          Json?
  assignee       User?              @relation("AssignedConversations", fields: [assigneeId], references: [id])
  bot            Bot?               @relation(fields: [botId], references: [id])
  contact        Contact            @relation(fields: [contactId], references: [id])
  facebookPage   FacebookPage?      @relation(fields: [facebookPageId], references: [id])
  messages       CrmMessage[]
  internalNotes  InternalNote[]

  @@index([contactId])
  @@index([assigneeId])
  @@index([externalSessionId])
  @@map("crm_conversations")
}

model CrmMessage {
  id             String          @id @default(cuid())
  conversationId String
  direction      String
  content        String
  createdAt      DateTime        @default(now())
  source         String          @default("human")
  conversation   CrmConversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@map("crm_messages")
}

model InternalNote {
  id             String          @id @default(cuid())
  content        String
  authorId       String
  conversationId String
  createdAt      DateTime        @default(now())
  author         User            @relation(fields: [authorId], references: [id])
  conversation   CrmConversation @relation(fields: [conversationId], references: [id])

  @@index([authorId])
  @@index([conversationId])
  @@map("internal_notes")
}

model Lead {
  id             String    @id @default(cuid())
  tenantId       String
  contactId      String?
  name           String?
  company        String?
  mobile         String?
  email          String?
  businessType   String?
  source         String    @default("facebook") // facebook, whatsapp, website
  status         String    @default("new") // new, contacted, qualified, converted, lost
  interestedInSubscription Boolean @default(false)
  selectedPlan   String? // free, starter, pro, business
  trialRequested Boolean   @default(false)
  converted      Boolean   @default(false)
  convertedAt    DateTime?
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  contact        Contact?  @relation(fields: [contactId], references: [id])

  @@index([tenantId])
  @@index([contactId])
  @@index([email])
  @@index([status])
  @@map("leads")
}

// OIDC Provider Models
model OidcModel {
  id        String   @id // key
  type      String   // model
  payload   Json     // the payload
  grantId   String?  // grantId, if applicable
  userCode  String?  // userCode, if applicable
  uid       String?  // uid, if applicable
  expiresAt DateTime? // expiration
  consumedAt DateTime? // consumed at
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, id]) // Composite unique constraint
  @@index([grantId])
  @@index([userCode])
  @@index([uid])
  @@map("oidc_models")
}

model public_Account {
  id                       String      @id
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  oauth_token_secret       String?
  oauth_token              String?
  refresh_token_expires_in Int?
  User                     public_User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("Account")
}

model Answer {
  createdAt  DateTime @default(now())
  resultId   String
  groupId    String
  blockId    String
  content    String
  variableId String?
  Result     Result   @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@unique([resultId, blockId, groupId])
}

model AnswerV2 {
  id               Int      @id @default(autoincrement())
  blockId          String
  content          String
  resultId         String
  createdAt        DateTime @default(now())
  attachedFileUrls Json?
  Result           Result   @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@index([blockId])
}

model ApiToken {
  id        String      @id
  token     String      @unique
  name      String
  ownerId   String
  createdAt DateTime    @default(now())
  User      public_User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model BannedIp {
  id                   String      @id
  createdAt            DateTime    @default(now())
  ip                   String      @unique
  responsibleTypebotId String
  userId               String
  Typebot              Typebot     @relation(fields: [responsibleTypebotId], references: [id])
  User                 public_User @relation(fields: [userId], references: [id])
}

model ChatSession {
  id         String   @id
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())
  state      Json
  isReplying Boolean?
}

model ClaimableCustomPlan {
  id           String    @id
  createdAt    DateTime  @default(now())
  claimedAt    DateTime?
  name         String
  description  String?
  price        Int
  currency     String
  workspaceId  String    @unique
  chatsLimit   Int
  storageLimit Int
  seatsLimit   Int
  companyName  String?
  isYearly     Boolean   @default(false)
  vatType      String?
  vatValue     String?
  Workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model CollaboratorsOnTypebots {
  userId    String
  typebotId String
  type      CollaborationType
  createdAt DateTime          @default(now())
  updatedAt DateTime          @default(now())
  Typebot   Typebot           @relation(fields: [typebotId], references: [id], onDelete: Cascade)
  User      public_User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, typebotId])
}

model Coupon {
  userPropertiesToUpdate Json
  code                   String    @id @unique
  dateRedeemed           DateTime?
}

model Credentials {
  id          String    @id
  data        String
  name        String
  type        String
  iv          String
  createdAt   DateTime  @default(now())
  workspaceId String
  Workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model CustomDomain {
  name        String    @id
  createdAt   DateTime  @default(now())
  workspaceId String
  Workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model DashboardFolder {
  id                    String            @id
  createdAt             DateTime          @default(now())
  name                  String
  parentFolderId        String?
  updatedAt             DateTime          @default(now())
  workspaceId           String
  DashboardFolder       DashboardFolder?  @relation("DashboardFolderToDashboardFolder", fields: [parentFolderId], references: [id])
  other_DashboardFolder DashboardFolder[] @relation("DashboardFolderToDashboardFolder")
  Workspace             Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  Typebot               Typebot[]
}

model Invitation {
  email     String
  typebotId String
  type      CollaborationType
  createdAt DateTime          @default(now())
  updatedAt DateTime          @default(now())
  Typebot   Typebot           @relation(fields: [typebotId], references: [id], onDelete: Cascade)

  @@unique([email, typebotId])
}

model Log {
  id          String   @id
  createdAt   DateTime @default(now())
  resultId    String
  status      String
  description String
  details     String?
  context     String?
  Result      Result   @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@index([resultId])
}

model MemberInWorkspace {
  userId      String
  workspaceId String
  role        WorkspaceRole
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now())
  User        public_User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  Workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model PublicTypebot {
  id                  String                @id
  typebotId           String                @unique
  groups              Json
  variables           Json
  edges               Json
  theme               Json
  settings            Json
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @default(now())
  version             String?
  events              Json?
  lastActivityAt      DateTime?
  Typebot             Typebot               @relation(fields: [typebotId], references: [id], onDelete: Cascade)
  RuntimeMediaIdCache RuntimeMediaIdCache[]

  @@index([lastActivityAt])
}

model Result {
  id                     String                   @id
  createdAt              DateTime                 @default(now())
  typebotId              String
  isCompleted            Boolean
  variables              Json
  hasStarted             Boolean?
  isArchived             Boolean?                 @default(false)
  lastChatSessionId      String?
  Answer                 Answer[]
  AnswerV2               AnswerV2[]
  Log                    Log[]
  Typebot                Typebot                  @relation(fields: [typebotId], references: [id], onDelete: Cascade)
  SetVariableHistoryItem SetVariableHistoryItem[]
  VisitedEdge            VisitedEdge[]

  @@index([typebotId, hasStarted, createdAt(sort: Desc)])
  @@index([typebotId, isCompleted])
}

model RuntimeMediaIdCache {
  provider        ChatProvider
  url             String
  mediaId         String
  expiresAt       DateTime?
  publicTypebotId String
  PublicTypebot   PublicTypebot @relation(fields: [publicTypebotId], references: [id], onDelete: Cascade)

  @@unique([publicTypebotId, provider, url])
  @@index([expiresAt])
}

model public_Session {
  id           String      @id
  sessionToken String      @unique
  userId       String
  expires      DateTime
  User         public_User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("Session")
}

model SetVariableHistoryItem {
  resultId   String
  index      Int
  variableId String
  blockId    String
  value      Json
  blockIndex Int?
  Result     Result @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@unique([resultId, index])
}

model ThemeTemplate {
  id          String    @id
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())
  name        String
  theme       Json
  workspaceId String
  Workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Typebot {
  id                      String                    @id
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @default(now())
  name                    String
  folderId                String?
  groups                  Json
  variables               Json
  edges                   Json
  theme                   Json
  settings                Json
  publicId                String?                   @unique
  customDomain            String?                   @unique
  icon                    String?
  workspaceId             String
  resultsTablePreferences Json?
  isArchived              Boolean                   @default(false)
  isClosed                Boolean                   @default(false)
  version                 String?
  selectedThemeTemplateId String?
  whatsAppCredentialsId   String?
  events                  Json?
  riskLevel               Int?
  BannedIp                BannedIp[]
  CollaboratorsOnTypebots CollaboratorsOnTypebots[]
  Invitation              Invitation[]
  PublicTypebot           PublicTypebot?
  Result                  Result[]
  DashboardFolder         DashboardFolder?          @relation(fields: [folderId], references: [id])
  Workspace               Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  Webhook                 Webhook[]

  @@index([isArchived, createdAt(sort: Desc)])
  @@index([workspaceId])
}

model public_User {
  id                          String                    @id
  name                        String?
  email                       String?                   @unique
  emailVerified               DateTime?
  image                       String?
  createdAt                   DateTime                  @default(now())
  lastActivityAt              DateTime                  @default(now())
  updatedAt                   DateTime                  @default(now())
  company                     String?
  onboardingCategories        Json
  graphNavigation             GraphNavigation?
  preferredAppAppearance      String?
  displayedInAppNotifications Json?
  referral                    String?
  groupTitlesAutoGeneration   Json?
  preferredLanguage           String?
  termsAcceptedAt             DateTime?
  Account                     public_Account[]
  ApiToken                    ApiToken[]
  BannedIp                    BannedIp[]
  CollaboratorsOnTypebots     CollaboratorsOnTypebots[]
  MemberInWorkspace           MemberInWorkspace[]
  Session                     public_Session[]
  UserCredentials             UserCredentials[]

  @@map("User")
}

model UserCredentials {
  id        String      @id
  createdAt DateTime    @default(now())
  userId    String
  data      String
  name      String
  type      String
  iv        String
  User      public_User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model public_VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  value      String?

  @@unique([identifier, token])
  @@map("VerificationToken")
}

model VisitedEdge {
  resultId String
  edgeId   String
  index    Int
  Result   Result @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@unique([resultId, index])
}

model Webhook {
  id          String   @id
  url         String?
  method      String
  queryParams Json
  headers     Json
  body        String?
  typebotId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  Typebot     Typebot  @relation(fields: [typebotId], references: [id], onDelete: Cascade)
}

model Workspace {
  id                            String                @id
  name                          String
  icon                          String?
  createdAt                     DateTime              @default(now())
  plan                          public_Plan           @default(FREE)
  stripeId                      String?               @unique
  additionalChatsIndex          Int                   @default(0)
  additionalStorageIndex        Int                   @default(0)
  chatsLimitFirstEmailSentAt    DateTime?
  chatsLimitSecondEmailSentAt   DateTime?
  storageLimitFirstEmailSentAt  DateTime?
  storageLimitSecondEmailSentAt DateTime?
  customChatsLimit              Int?
  customSeatsLimit              Int?
  customStorageLimit            Int?
  updatedAt                     DateTime              @default(now())
  isQuarantined                 Boolean               @default(false)
  isSuspended                   Boolean               @default(false)
  isPastDue                     Boolean               @default(false)
  isVerified                    Boolean?
  chatsHardLimit                Int?
  settings                      Json?
  inactiveFirstEmailSentAt      DateTime?
  inactiveSecondEmailSentAt     DateTime?
  lastActivityAt                DateTime?
  ClaimableCustomPlan           ClaimableCustomPlan?
  Credentials                   Credentials[]
  CustomDomain                  CustomDomain[]
  DashboardFolder               DashboardFolder[]
  MemberInWorkspace             MemberInWorkspace[]
  ThemeTemplate                 ThemeTemplate[]
  Typebot                       Typebot[]
  WorkspaceInvitation           WorkspaceInvitation[]
}

model WorkspaceInvitation {
  id          String        @id
  createdAt   DateTime      @default(now())
  email       String
  workspaceId String
  type        WorkspaceRole
  updatedAt   DateTime      @default(now())
  Workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

enum ChatProvider {
  WHATSAPP
  DIALOG360
}

enum CollaborationType {
  READ
  WRITE
  FULL_ACCESS
}

enum GraphNavigation {
  MOUSE
  TRACKPAD
}

enum public_Plan {
  FREE
  STARTER
  PRO
  LIFETIME
  OFFERED
  CUSTOM
  UNLIMITED
  ENTERPRISE

  @@map("Plan")
}

enum WorkspaceRole {
  ADMIN
  MEMBER
  GUEST
}
