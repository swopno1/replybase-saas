# ==============================================
# ReplyBase SaaS - Production Environment Template
# ==============================================
# This file contains ONLY sensitive secrets and critical environment overrides.
# Static configuration and non-secret defaults are managed in: lib/config.ts
# ==============================================

# ----- CORE INFRASTRUCTURE -----
# [MANDATORY] Environment type (development, production, test)
NODE_ENV=production

# [MANDATORY] Database connection (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require
# [OPTIONAL] Required for Prisma migrations on some cloud platforms
SHADOW_DATABASE_URL=

# [MANDATORY] Redis URL for workers and caching
REDIS_URL=redis://localhost:6379

# ----- DEPLOYMENT & DOMAINS -----
# [OPTIONAL] Public URL of the application. 
NEXT_PUBLIC_APP_URL=https://app.replybase.co.uk
NEXT_PUBLIC_BASE_URL=https://app.replybase.co.uk

# [MANDATORY] NextAuth URL (Must match the public domain)
NEXTAUTH_URL=https://app.replybase.co.uk

# ----- AUTHENTICATION & SECURITY -----
# [MANDATORY] Generate: openssl rand -base64 32
AUTH_SECRET=""

# [MANDATORY] Key for encrypting tenant channel credentials in DB
# Generate with: openssl rand -base64 32
CHANNEL_CREDENTIALS_ENCRYPTION_KEY=""

# [OPTIONAL] API Secrets
API_SECRET_KEY=""
CRON_SECRET=""

# ----- AI PROVIDER SECRETS -----
# [MANDATORY] API Keys for providers you intend to use
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# [MANDATORY] if using DigitalOcean AI Inference
DIGITALOCEAN_AI_KEY=

# ----- STRIPE BILLING -----
# [MANDATORY] Production keys (starts with sk_live_)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# [MANDATORY] Subscription Price IDs
NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID=
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=
NEXT_PUBLIC_STRIPE_BUSINESS_PRICE_ID=

# ----- OAUTH & CHANNEL SECRETS -----
# Google OAuth (Sign in with Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook/Meta API
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_WEBHOOK_VERIFY_TOKEN=""

# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# Telegram Bot API
TELEGRAM_TOKEN_ENCRYPTION_KEY=""

# ----- EMAIL (RESEND) -----
# [MANDATORY] Production API Key for notifications
RESEND_API_KEY=

# ----- THIRD-PARTY MONITORING -----
# [OPTIONAL] Analytics Keys
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# [MANDATORY] Sentry Error Monitoring & Performance
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Upstash Redis (Optional fallback for rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

