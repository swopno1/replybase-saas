# ==============================================
# ReplyBase SaaS - Environment Configuration
# ==============================================
# This file serves as a template for your .env file
# Copy this to .env and fill in all values
# NEVER commit .env to version control
# ==============================================

# ----- CORE APPLICATION -----
# [MANDATORY] Environment type (development, production, test)
NODE_ENV=production

# [MANDATORY] Base URL of the application
# [FALLBACK: http://localhost:3000]
NEXT_PUBLIC_APP_URL=https://app.replybase.co.uk
NEXT_PUBLIC_BASE_URL=https://app.replybase.co.uk

# [OPTIONAL] Log level (debug, info, warn, error)
# [FALLBACK: info]
LOG_LEVEL=info

# ----- AUTHENTICATION -----
# [MANDATORY] Generate with: openssl rand -base64 32
# MUST be secure random string (32+ chars)
AUTH_SECRET=

# [MANDATORY] Should match NEXT_PUBLIC_APP_URL
# [FALLBACK: http://localhost:3000]
NEXTAUTH_URL=https://app.replybase.co.uk

# [OPTIONAL] Enable strict development login bypasses
# [FALLBACK: false]
STRICT_DEV_LOGIN=false

# ----- DATABASE -----
# [MANDATORY] PostgreSQL connection string
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://REPLACE_WITH_DB_CREDENTIALS

# ----- GOOGLE OAUTH -----
# [OPTIONAL] Used for Social Login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----- FACEBOOK OAUTH & API -----
# [OPTIONAL] Required if you want Facebook Login and Facebook/Instagram bot channels
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# [OPTIONAL] Verification token for Facebook webhooks
FACEBOOK_WEBHOOK_VERIFY_TOKEN=

# ----- WHATSAPP CLOUD API -----
# [OPTIONAL] Required if using WhatsApp channels
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# [OPTIONAL] Override webhook URL for WhatsApp specifically
WHATSAPP_WEBHOOK_BASE_URL=

# ----- TELEGRAM API -----
# [OPTIONAL] Required if using Telegram channels
# [FALLBACK: AUTH_SECRET]
TELEGRAM_TOKEN_ENCRYPTION_KEY=
# [OPTIONAL]
TELEGRAM_API_TIMEOUT_MS=
TELEGRAM_WEBHOOK_BASE_URL=

# ----- CHANNEL CREDENTIALS -----
# [OPTIONAL] Encryption key for sensitive channel credentials
# [FALLBACK: AUTH_SECRET]
CHANNEL_CREDENTIALS_ENCRYPTION_KEY=

# ----- WEBCHAT CONFIGURATION -----
# [OPTIONAL] Webchat signing secrets
# [FALLBACK: AUTH_SECRET]
WEBCHAT_INIT_CHALLENGE_SECRET=
WEBCHAT_TOKEN_SECRET=

# [OPTIONAL] Security & Anti-abuse
# [FALLBACK: true]
WEBCHAT_BOT_MITIGATION_ENABLED=true
WEBCHAT_METRICS_ENABLED=true
# [FALLBACK: memory]
WEBCHAT_RATE_LIMIT_STORE=

# [OPTIONAL] Webchat Tenant Constraints
WEBCHAT_ALLOWED_ORIGINS=
WEBCHAT_ALLOWED_PLAN_NAMES=
WEBCHAT_ALLOW_WILDCARD_IN_PRODUCTION=false
WEBCHAT_DISABLED_TENANT_IDS=
WEBCHAT_ENABLED_TENANT_IDS=
WEBCHAT_PILOT_TENANT_IDS=
WEBCHAT_REQUIRE_ORIGIN_OR_REFERER=true
WEBCHAT_STRICT_ORIGIN_REFERER_MATCH=true
WEBCHAT_MIN_INIT_ELAPSED_MS=
WEBCHAT_PII_RETENTION_MODE=
WEBCHAT_ROLLOUT_MODE=

# ----- STRIPE BILLING -----
# [MANDATORY for billing] Secret key (starts with sk_live_ or sk_test_)
STRIPE_SECRET_KEY=
# [MANDATORY for billing] Publishable key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# [MANDATORY for billing] Webhook secret (starts with whsec_)
STRIPE_WEBHOOK_SECRET=

# [MANDATORY for billing] Stripe Price IDs
NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID=
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=
NEXT_PUBLIC_STRIPE_BUSINESS_PRICE_ID=

# ----- AI PROVIDERS -----
# [OPTIONAL] At least one is required if you want AI fallback features to work
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# ----- ADMIN & INTERNAL -----
# [OPTIONAL] Comma separated list of admin emails
# [FALLBACK: empty]
ADMIN_EMAILS=
# [OPTIONAL] The initial admin who signs up
INITIAL_ADMIN_EMAIL=

# ----- CRON JOB SECURITY -----
# [MANDATORY if using cron jobs] Shared secret for cron endpoints
CRON_SECRET=

# ----- EMAIL (RESEND) -----
# [OPTIONAL] Required for sending lead notifications and trial reminders
RESEND_API_KEY=
# [OPTIONAL] [FALLBACK: ReplyBase Leads <noreply@replybase.co.uk>]
LEAD_NOTIFICATION_EMAIL_FROM=
# [OPTIONAL] [FALLBACK: LEAD_NOTIFICATION_EMAIL_FROM or default]
TRIAL_REMINDER_EMAIL_FROM=

# ----- REDIS (RATE LIMITING / WORKERS) -----
# [OPTIONAL] Main Redis connection string used for BullMQ workers and caching
# [FALLBACK: redis://localhost:6379]
REDIS_URL=

# [OPTIONAL] Upstash Redis (Serverless) fallback for specific rate limiters
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ----- CHANNEL CONFIG OVERRIDES -----
# [OPTIONAL] Override the default channel visibility and enablement status
# By default, only Webchat and Facebook are visible in the UI (defined in lib/channel-config.data.ts).
# Set this if you want to strictly disable other channels entirely.
# [FALLBACK: Default config from lib/channel-config.data.ts]
# Example: {"whatsapp":{"enabled":true,"uiVisible":true},"telegram":{"enabled":false}}
CHANNEL_CONFIG_OVERRIDES_JSON=

# ----- KPI / THRESHOLDS -----
# [OPTIONAL] Custom KPI tracking thresholds
KPI_MAX_DAYS_FIRST_CHANNEL=
KPI_MAX_DAYS_FIRST_REPLY=
KPI_MAX_WEBHOOK_FAILURE_RATE=
KPI_MIN_EVENT_AGE_HOURS=
KPI_MIN_FIRST_CHANNEL_RATE=
KPI_MIN_FIRST_REPLY_RATE=
KPI_MIN_WEBHOOK_ATTEMPTS=

# ----- MARKETING SITE INTEGRATION -----
# [OPTIONAL] Required if communicating with an external marketing site
API_SECRET_KEY=
API_TOKEN=

# ----- ANALYTICS & MONITORING -----
# [OPTIONAL] Plausible Analytics
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRC=https://analytics.replybase.co.uk/js/script.js
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=app.replybase.co.uk

# [OPTIONAL] Microsoft Clarity
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# [OPTIONAL] Google Search Console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# [OPTIONAL] PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
