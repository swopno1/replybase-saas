# ==============================================
# ReplyBase SaaS - Environment Configuration
# ==============================================
# This file serves as a template for your .env file
# Copy this to .env and fill in all values
# NEVER commit .env to version control
# ==============================================

# ----- CORE APPLICATION -----
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://app.replybase.co.uk

# ----- AUTHENTICATION -----
# Generate with: openssl rand -base64 32
# MUST be secure random string (32+ chars)
AUTH_SECRET=

# Should match NEXT_PUBLIC_APP_URL
NEXTAUTH_URL=https://app.replybase.co.uk

# ----- GOOGLE OAUTH -----
# Get from: https://console.cloud.google.com/apis/credentials
# 1. Create OAuth 2.0 Client ID
# 2. Add authorized redirect: https://app.replybase.co.uk/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ----- FACEBOOK OAUTH -----
# Get from: https://developers.facebook.com/apps
# 1. Create app
# 2. Add Facebook Login product
# 3. Add OAuth redirect: https://app.replybase.co.uk/api/auth/callback/facebook
# 4. Ensure scopes include: pages_show_list, pages_read_engagement,
#    pages_manage_metadata, pages_messaging, business_management,
#    whatsapp_business_management, whatsapp_business_messaging
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret

# For Facebook webhook verification
# Can be any random string you choose (remember it for webhook setup)
FACEBOOK_WEBHOOK_VERIFY_TOKEN=your-chosen-verify-token

# ----- CHANNEL CONFIG OVERRIDE (OPTIONAL) -----
# Default channel behavior is defined in lib/channel-config.data.ts
# Use this only when you need environment-level overrides without code changes.
# Example:
# CHANNEL_CONFIG_OVERRIDES_JSON={"facebook":{"enabled":true,"uiVisible":true},"whatsapp":{"enabled":true,"uiVisible":true}}
CHANNEL_CONFIG_OVERRIDES_JSON=

# ----- WHATSAPP CLOUD API -----
# Uses Meta Graph API with your app access configuration
# Callback URL in Meta should point to:
#   https://app.replybase.co.uk/api/whatsapp/webhook
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-chosen-whatsapp-verify-token

# Optional override if webhook base URL differs from NEXTAUTH_URL
# WHATSAPP_WEBHOOK_BASE_URL=https://app.replybase.co.uk

# ----- DATABASE -----
# PostgreSQL connection string
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# Example: postgresql://user:pass@db.example.com:5432/replybase?sslmode=require
DATABASE_URL=postgresql://REPLACE_WITH_DB_CREDENTIALS

# ----- STRIPE -----
# Get from: https://dashboard.stripe.com/apikeys

# Secret key (starts with sk_live_ for production, sk_test_ for testing)
STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_STRIPE_SECRET_KEY

# Publishable key (starts with pk_live_ for production, pk_test_ for testing)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Webhook secret (get from: https://dashboard.stripe.com/webhooks)
# Create webhook endpoint: https://app.replybase.co.uk/api/billing/webhook
# Events to listen: checkout.session.completed, customer.subscription.*
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_WEBHOOK_SECRET

# ----- STRIPE PRICE IDs -----
# These are set AFTER you create products/prices in Stripe
# Current standard pricing: Starter £29, Pro £89, Business £249
# Run: npm run seed:stripe to create products and get these IDs
# Or create manually in Stripe Dashboard

# Starter Plan Price ID
NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID=

# Pro Plan Price ID
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=

# Business Plan Price ID
NEXT_PUBLIC_STRIPE_BUSINESS_PRICE_ID=

# ----- OPTIONAL / FUTURE -----

# ----- LEAD NOTIFICATIONS (MVP) -----
# Lead destination emails and Telegram chat IDs are configured per tenant
# in Settings > Notifications (not via environment variables).

# Email provider settings for lead notifications and trial reminders (Resend).
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL_FROM="ReplyBase Leads <admin@replybase.co.uk>"
# Optional: separate from address for trial reminder emails.
# Falls back to LEAD_NOTIFICATION_EMAIL_FROM if not set.
TRIAL_REMINDER_EMAIL_FROM="ReplyBase <admin@replybase.co.uk>"

# ----- CRON JOB SECURITY -----
# Shared secret required by all cron endpoints to prevent unauthorized invocation.
# Generate with: openssl rand -hex 32
# Send as: Authorization: Bearer <CRON_SECRET>
# Schedule daily with Vercel Cron, GitHub Actions, or any HTTP scheduler.
#
# Vercel vercel.json example:
#   { "crons": [{ "path": "/api/cron/trial-reminders", "schedule": "0 8 * * *" }] }
# GitHub Actions example:
#   curl -H "Authorization: Bearer $CRON_SECRET" https://app.replybase.co.uk/api/cron/trial-reminders
CRON_SECRET=

# ----- MARKETING SITE INTEGRATION -----
# Generate with: openssl rand -hex 32
# This key must match REPLYBASE_API_SECRET on your marketing site (https://replybase.co.uk/)
# Allows marketing site to access newsletter and data deletion APIs
API_SECRET_KEY=

# ----- ANALYTICS & MONITORING -----
# Self-hosted Plausible endpoint and domain used by script.js
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRC=https://analytics.replybase.co.uk/js/script.js
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=app.replybase.co.uk

# Microsoft Clarity project ID
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Google Search Console HTML verification value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional PostHog (event sink)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ==============================================
# SETUP INSTRUCTIONS
# ==============================================
#
# 1. Copy this file:
#    cp .env.example .env
#
# 3. Generate AUTH_SECRET:
#    openssl rand -base64 32
#
# 5. Set up external services:
#    - Google OAuth (console.cloud.google.com)
#    - Facebook OAuth (developers.facebook.com)
#    - Stripe (dashboard.stripe.com)
#    - Database (your PostgreSQL instance)
#
# 6. Fill in all REPLACE_WITH_* values
#
# 7. Verify configuration:
#    npm run build (should succeed)
#
# 8. Deploy to production
#
# ==============================================
# SECURITY NOTES
# ==============================================
#
# - NEVER commit .env to git (add to .gitignore)
# - Store production .env in secure password manager
# - Use different values for development/production
# - Rotate secrets periodically (every 90 days)
# - Use environment-specific Stripe keys (test vs live)
#
# ==============================================
